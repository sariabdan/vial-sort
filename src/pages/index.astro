---
// The home page tells the whole project on one page: the hero, a summary band with three numbers, then five numbered
// sections with one picture, chart or video each, built from the same parts as the other pages (steps, points, vials). Everything detailed lives on the reference pages (Data, Training, Models,
// Testing, Results, Lab notes), which the last section lists. Every number here is read from the same data files as
// those pages; none is typed in.
import Base from '../layouts/Base.astro';
import Chapter from '../components/Chapter.astro';
import Hero from '../components/Hero.astro';
import Clip from '../components/Clip.astro';
import SlotVials from '../components/SlotVials.astro';
import october from '../data/october.json';
import ws220 from '../data/ws220.json';
import results from '../data/results.json';
import datasets from '../data/datasets.json';
import experiments from '../data/experiments.json';
import media from '../data/media.json';
import { url, HF, CODE, CAMERA_NAMES } from '../lib/site';
import { scoreRun, pctOf, PASS_MARK } from '../lib/score';
import { PROBE } from '../lib/probe';

const cov = october.coverage;
const rows = results.rows;
const demoSets = results.demo_sets as Record<string, { per_source: Record<string, number>; per_destination: Record<string, number> }>;
const stages = results.stages;
const t = results.tiles;
// the newest run overall, in the order the Results page lists runs (latest day first, then the bigger run)
const board = [...rows].sort((a, b) => (b.days.at(-1) ?? '').localeCompare(a.days.at(-1) ?? '') || b.rollouts - a.rollouts);
const newest = board[0];
const score = scoreRun(newest.by_destination);
// the newest run of the π0.5 models, which chapters 02 and 03 compare
const newestPi = board.find((r) => r.family === 'pi05')!;
const scorePi = scoreRun(newestPi.by_destination);
const anyPassed = rows.some((r) => scoreRun(r.by_destination).verdict === 'passed');
// a model's row with the most rollouts
const biggest = (model: string) => rows.filter((r) => r.model === model).sort((a, b) => b.rollouts - a.rollouts)[0];
const nameOf = (run: string) => experiments.models.find((m) => m.run === run);
// the three π0.5 runs the story compares: trained on the 100, then the two retrains on the 220
const first = biggest(nameOf('pi05-canon')!.id), fromFirst = biggest(nameOf('pi05-b16k')!.id);
const compared = [
  { r: first, how: 'trained on the 100 demonstrations' },
  { r: fromFirst, how: `continued from ${first.name}, on the 220` },
  { r: newestPi, how: 'trained from the base model on the 220' },
].filter((x) => x.r);
const clips = ['released', 'carried', 'no_grasp']
  .map((s) => media.featured.find((f) => f.row === newest.key && f.stage === s)).filter((f) => !!f);
const cams = ['top_down', 'left_top', 'left_bottom', 'right', 'wrist'];
const sessions = datasets.datasets.filter((d) => d.kind === 'rollout').length;
const maxRun = Math.max(...rows.map((r) => r.rollouts));
const refs = [
  { href: 'datasets/', name: 'Data', text: `The five cameras, the ${cov.episodes} and the ${ws220.episodes} demonstrations move by move, how the commands were worded, and all ${sessions} robot recordings.` },
  { href: 'training/', name: 'Training', text: 'The offline tests of what a model reads from its command, and every loss curve.' },
  { href: 'models/', name: 'Models', text: `All ${experiments.models.length} models: what each started from, what it saw, and its settings.` },
  { href: 'method/', name: 'Testing', text: 'How a rollout is run and scored, how the score of a run is built, and what the numbers cannot say.' },
  { href: 'results/', name: 'Results', text: `Every model and checkpoint on the robot: ${results.total} scored rollouts, slot by slot and move by move, with videos.` },
  { href: 'docs/lab-notes.html', name: 'Lab notes', text: 'The dated notes of each arm test and retrain, as written at the time.' },
  { href: 'docs/', name: 'Documentation', text: 'How this site is built, where its numbers come from, and the open work.' },
  { href: 'previous/', name: 'Previous work', text: 'The August system on the Thor rig: its evaluation, datasets and report.' },
  { href: 'glossary/', name: 'Glossary', text: 'The words the site uses in a defined sense.' },
];
---
<Base
  page="home"
  title="Vial sort"
  description="A low-cost SO-101 arm sorts translucent vials between two racks and a bin on spoken position commands. The latest work trains π0.5 on 220 demonstrations seen by five cameras. Videos, results, training runs and data."
>
  <Hero />

  <section class="top">
    <div class="story">
      <div class="tldr">
        <p class="tldr-tag">In short</p>
        <div class="tldr-grid">
          <div>
            <p class="tldr-main">
              {`The newest model, ${newest.name}, picks up the right vial in ${newest.grasped_right} of ${newest.rollouts} moves and `}
              <strong>{`puts it in the asked slot in ${newest.stages.released}`}</strong>.
            </p>
            <p class="note stats-note">{`${newest.label}, ${newest.scored_by === 'notes' ? "scored from the operator's notes at the robot" : 'scored from the arm'}. `}<a href={url('method/#score')}>How the score is built</a></p>
          </div>
          <ul class="stats">
            <li class="pass"><span class="big">{pctOf(score.trained)}</span><b>What works</b><span>in the asked slot, for the slots the demonstrations used as a destination.</span></li>
            <li class="fail"><span class="big">{pctOf(score.held)}</span><b>What is open</b><span>for the slots no demonstration used as a destination.</span></li>
            <li><span class="big">{pctOf(score.total)}</span><b>Its score</b><span>{`the mean over the 12 rack slots; a run passes at ${PASS_MARK * 100}%${anyPassed ? '' : ', and none has yet'}.`}</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Chapter no="01" label="Setup and data" id="setup" title="A 3D-printed arm, five cameras, 220 demonstrations">
    <div class="setup">
      <div>
        <p>The arm is an SO-101, a 3D-printed six-joint design, built as a leader and a follower. Every model on this site came out of the same three steps.</p>
        <ol class="flow">
          <li><b>Demonstrate</b><span>A person moves the leader arm and the follower copies it, while five cameras record.</span></li>
          <li><b>Train</b><span>Three kinds of model learn from the demonstrations: π0.5, FLUX 3 Action and Isaac 0.5.</span></li>
          <li><b>Run</b><span>The model reads the cameras and the joint angles and drives the six joints. Nobody steers it.</span></li>
        </ol>
        <ul class="cams" aria-label={`The five camera views, recorded at ${cov.fps} frames a second`}>
          {cams.map((c) => (
            <li><img src={url(`img/cams/${c}.webp`)} width="640" height="480" loading="lazy" alt={`The ${CAMERA_NAMES[c]} camera's view of the table`} /><span>{CAMERA_NAMES[c]}</span></li>
          ))}
        </ul>
        <ul class="facts">
          <li><strong>{ws220.episodes}</strong> demonstrations</li>
          <li><strong>{ws220.moves}</strong> different moves</li>
          <li><strong>{ws220.minutes}</strong> minutes</li>
          <li><strong>{cov.fps}</strong> frames a second, five cameras</li>
        </ul>
        <p class="more"><a href={url('datasets/')}>The data in full →</a>{' · '}<a href={url('models/')}>What each model is →</a></p>
      </div>
      <figure class="rig">
        <img src={url('img/setup_current.webp')} width="1362" height="1599" loading="lazy"
          alt="The current rig, labelled: the right, top-down, left-top and left-bottom cameras on stands and an arm above the table, the wrist camera on the follower arm, two racks with coloured vials, the bin, the follower arm on the left and the leader arm in the foreground." />
        <figcaption class="note">The current rig: the five cameras, the two racks, the bin, the follower arm that does the work and the leader arm a person moves.</figcaption>
      </figure>
    </div>
  </Chapter>

  <Chapter no="02" label="The problem" id="problem" title="The first models read the destination off the picture">
    <div class="split">
      <div>
        <p>{`The first ${cov.episodes} demonstrations were recorded one destination per sitting. ${first.name}, trained on them, reached for the vial the command named, but took where to put it from the camera images:`}</p>
        <ol class="flow plain">
          <li><b>The camera picture</b><span>says which sitting a frame is from.</span></li>
          <li><b>The sitting</b><span>says the destination, because each sitting had only one.</span></li>
          <li><b>The destination</b><span>is read off the picture, not the command.</span></li>
        </ol>
        <p>{`In the newer demonstrations one layout is recorded three times, to three different destinations, so only the command can tell them apart.`}</p>
        <p class="more"><a href={url('training/#why')}>The offline tests in full →</a></p>
      </div>
      <figure class="chart-card">
        <figcaption>{`A probe on training frames of ${first.name}: how often the arm does what the row says`}</figcaption>
        <div class="hbars">
          {PROBE.filter((x) => x.short).map((x) => (
            <div class="hbar">
              <span class="hbar-label">{x.short}</span>
              <span class="hbar-track"><i style={`width: ${x.at12k}%`}></i></span>
              <span class="hbar-n num">{x.at12k}%</span>
            </div>
          ))}
        </div>
        <p class="note">{`In the offline test, ${t.gate.dest_passed} of its ${t.gate.checkpoints} checkpoints read the destination slot from the command.`}</p>
      </figure>
    </div>
  </Chapter>

  <Chapter no="03" label="Results" id="results" title="With the new data, the destination follows the command">
    <p>{`${newestPi.name}, trained from the base model on the ${ws220.episodes}, put the vial in the asked slot in ${newestPi.stages.released} of ${newestPi.rollouts} moves. Each row below is one run, drawn as on the Results page: a vial per slot, filled to the share of rollouts that got through.`}</p>
    <ul class="legend vkey" aria-label="How to read the vials">
      <li><i class="kv k3"><i></i></i>all</li>
      <li><i class="kv k2"><i></i></i>half or more</li>
      <li><i class="kv k1"><i></i></i>under half</li>
      <li><i class="kv k0"><i></i></i>none</li>
      <li><i class="kv kn"><i></i></i>not tried</li>
      <li><i class="kv kh"><i></i></i>never demonstrated that way</li>
    </ul>
    <div class="res-split"><div class="res-rows">
    <div class="hrows">
      <div class="hrow hhead" aria-hidden="true">
        <div class="hcap"><p><b>Picked up from</b><span>the slot the vial started in</span></p><div class="caps"><span class="c6">left rack</span><span class="c6">right rack</span></div></div>
        <div class="hcap"><p><b>Placed into</b><span>the slot the command asked for</span></p><div class="caps"><span class="c6">left rack</span><span class="cb">bin</span><span class="c6">right rack</span></div></div>
      </div>
      {compared.map(({ r, how }) => (
        <div class="hrow">
          <p class="hwho">
            <i style={`background: var(--m-${r.family})`}></i><b>{r.name}</b><span>{how}</span>
            <b class="num sc">{pctOf(scoreRun(r.by_destination).total)}</b>
            <span>{`${r.stages.released} of ${r.rollouts} in the asked slot`}</span>
          </p>
          <SlotVials bySource={r.by_source} byDestination={r.by_destination} demos={r.train_set ? demoSets[r.train_set] : null} label={r.label} />
        </div>
      ))}
    </div>
    <p class="more"><a href={url('results/')}>{`Compare any of the ${rows.length} runs, with video: ${results.total} rollouts →`}</a></p>
    </div><div class="res-open">
    <h3 class="sub">What is not solved</h3>
    <ul class="points">
      <li class="fail"><b>Unseen destinations</b><span>{`${pctOf(scorePi.held)} on the slots no demonstration used as a destination, against ${pctOf(scorePi.trained)} on the others.`}</span></li>
      <li><b>The pass mark</b><span>{anyPassed ? `A run passes at ${PASS_MARK * 100}% with at least 10 rollouts at every slot.` : `No run has reached ${PASS_MARK * 100}% with at least 10 rollouts at every slot.`}</span></li>
      <li><b>Small numbers</b><span>{`The biggest run has ${maxRun} rollouts and many have a handful, so one rollout moves a run a long way.`}</span></li>
      <li class="quiet"><b>Not a planned evaluation</b><span>These are test runs made during development. <a href={url('method/#caveats')}>What the numbers cannot say</a></span></li>
    </ul>
    </div></div>
  </Chapter>

  <Chapter no="04" label="Clips" id="clips" title="Rollouts on video">
    <p>{`One rollout of ${newest.name} for each outcome. They loop; click one to pause it.`}</p>
    <div class="clips">
      {clips.map((f) => (
        <Clip src={f!.src} poster={f!.poster} w={f!.w} h={f!.h} caption={f!.caption} move={f!.move}
          vialAt={f!.at ?? undefined} missAt={f!.miss ?? undefined} vial={(f!.vial ?? 'neutral') as 'red'} outcome={f!.stage} kind={f!.kind} />
      ))}
    </div>
    <p class="more"><a href={`${url('results/')}#h-watch`}>Rollouts of every model →</a></p>
  </Chapter>

  <Chapter no="05" label="The pages" id="pages" title="Everything in detail">
    <ul class="refs">
      {refs.map((r) => <li><a href={url(r.href)}>{r.name}</a><span class="note">{r.text}</span></li>)}
    </ul>
    <p class="more ext"><a href={`${HF}/sari-abdan`}>Data and models on Hugging Face</a>{' · '}<a href={CODE}>Code on GitHub</a></p>
  </Chapter>
</Base>

<style>
  .top { padding-block: 0.4rem 0.8rem; }
  .more { margin-top: 1rem; font-weight: 560; }
  .ext { font-weight: 400; }
  .sub { font-size: var(--step-1); margin: 1.6rem 0 0.2rem; }

  /* in short: the sentence on the left, three numbers on the right, in one band */
  .tldr { position: relative; padding: 1.5rem clamp(1rem, 3vw, 1.8rem) 1.2rem; border: 1.5px solid var(--ink); border-radius: 8px; background: var(--raise); box-shadow: 0.4rem 0.4rem 0 var(--accent); }
  .tldr-tag { position: absolute; top: -0.9rem; left: 1.2rem; margin: 0; padding: 0.05rem 0.7rem; font-size: 0.95rem; font-weight: 680; font-stretch: 112%;
              letter-spacing: 0.04em; text-transform: uppercase; background: var(--accent); color: var(--page); border: 1.5px solid var(--ink); border-radius: 5px; }
  .tldr-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 1rem clamp(1.2rem, 3vw, 2.4rem); align-items: start; }
  .tldr-main { font-size: clamp(1.25rem, 2.3vw, var(--step-2)); line-height: 1.22; font-weight: 620; font-stretch: 108%; max-width: none; }
  .tldr-main strong { color: var(--accent); font-weight: inherit; }
  .stats-note { margin-top: 0.7rem; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem 1.2rem; }
  .stats li { display: grid; align-content: start; gap: 0.15rem; padding-top: 0.5rem; border-top: 3px solid var(--ink); font-size: var(--step--1); line-height: 1.35; color: var(--ink-2); }
  .stats li.pass { border-top-color: var(--st-3); }
  .stats li.fail { border-top-color: var(--st-1); }
  .stats .big { font-size: var(--step-4); font-weight: 680; font-stretch: 112%; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stats b { color: var(--ink); font-weight: 650; }

  .setup { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.2rem clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .rig { margin: 0; width: min-content; }
  .rig img { display: block; height: clamp(19rem, 26vw, 24rem); width: auto; max-width: none; border-radius: 6px; }  /* sized by height, so it stays level with the steps and cameras beside it */
  .rig figcaption { margin-top: 0.5rem; }
  .cams { list-style: none; margin: 1rem 0 0.8rem; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.5rem; }
  .cams li { display: grid; gap: 0.2rem; font-size: 0.85rem; color: var(--ink-2); line-height: 1.2; }
  .cams img { width: 100%; height: auto; border-radius: 4px; background: var(--raise); }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .facts li { padding: 0.2rem 0.75rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--raise); color: var(--ink-2); font-size: 0.95rem; }
  .facts strong { color: var(--ink); font-variant-numeric: tabular-nums; }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.2rem clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .split p + p { margin-top: 0.7rem; }
  .chart-card { margin: 0; padding: 1rem 1.2rem 1.1rem; border: 1px solid var(--rule); border-radius: 8px; background: var(--raise); }
  .chart-card figcaption { font-weight: 620; font-stretch: 108%; margin-bottom: 0.8rem; line-height: 1.3; }
  .chart-card .note { margin-top: 0.9rem; }
  .hbars { display: grid; gap: 0.8rem; }
  .hbar { display: grid; grid-template-columns: minmax(0, 1fr) 3.4rem; gap: 0.2rem 0.8rem; align-items: center; }
  .hbar-label { grid-column: 1 / -1; font-size: 0.95rem; color: var(--ink-2); line-height: 1.3; }
  .hbar-track { height: 1.2rem; background: var(--grid); border-radius: 4px; overflow: hidden; }
  .hbar-track i { display: block; height: 100%; background: var(--accent); border-radius: 4px 0 0 4px; }
  .hbar-n { font-weight: 680; text-align: right; }

  /* the three runs as rows of vials, as on Results (src/components/SlotVials.astro), with its key above them */
  .vkey { margin: 0.9rem 0 0.6rem; font-size: 0.9rem; gap: 0.25rem 0.9rem; color: var(--ink-2); }
  .vkey .kv { display: flex; align-items: flex-end; overflow: hidden; box-sizing: border-box; width: 9px; height: 18px; border: 1.25px solid var(--steel); border-top: 0; border-radius: 0 0 5px 5px; background: var(--page); }
  .vkey .kv i { display: block; width: 100%; height: 100%; border-radius: 0; background: var(--st-3); }
  .vkey .k2 i { height: 65%; background: color-mix(in srgb, var(--st-3) 55%, white); }
  .vkey .k1 i { height: 30%; background: var(--st-2); }
  .vkey .k0 i, .vkey .kn i, .vkey .kh i { height: 0; }
  .vkey .kn { border-color: var(--rack); }
  .vkey .kh { border: 1.5px dashed var(--ink); border-top: 0; }
  /* on a wide screen the open points sit beside the rows instead of under them */
  .res-rows, .res-open { min-width: 0; }
  @media (min-width: 84rem) {
    .res-split { display: grid; grid-template-columns: minmax(0, 46rem) minmax(0, 1fr); gap: 0 clamp(2rem, 3vw, 3.5rem); align-items: start; }
    .res-open .sub { margin-top: 0; }
    .res-open .points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .hrows { container-type: inline-size; --vw: 24px; --vh: 38px; --vgap: 12px; --vbin: 34px; display: grid;
           --from: calc(12 * var(--vw) + var(--vgap)); --into: calc(12 * var(--vw) + var(--vbin) + 2 * var(--vgap)); }
  .hrow { display: grid; grid-template-columns: var(--from) var(--into); gap: 0.35rem 1.6rem; align-items: end; justify-content: start; padding: 0.6rem 0 0.5rem; border-top: 1px solid var(--rule); }
  .hhead { border-top: 0; padding: 0 0 0.3rem; }
  .hwho { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.6rem; margin: 0; max-width: none; font-size: 0.95rem; color: var(--ink-2); }
  .hwho i { width: 0.65rem; height: 0.65rem; border-radius: 50%; align-self: center; }
  .hwho b { color: var(--ink); font-weight: 650; }
  .hwho .sc { font-size: 1.3rem; font-weight: 680; font-stretch: 112%; margin-left: 0.6rem; }
  .hcap p { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; margin: 0 0 0.25rem; max-width: none; font-size: 0.95rem; }
  .hcap p b { font-weight: 650; }
  .hcap p span { font-size: 0.8rem; color: var(--ink-2); }
  .caps { display: flex; gap: var(--vgap); font-size: 0.72rem; color: var(--steel); line-height: 1; }
  .caps .c6 { width: calc(6 * var(--vw)); }
  .caps .cb { width: var(--vbin); text-align: center; }
  @container (max-width: 40rem) { .hrows { --vw: 21px; --vgap: 10px; --vbin: 30px; } }
  @container (max-width: 35rem) { .hrow { grid-template-columns: minmax(0, 1fr); } .hhead { display: none; } }

  .clips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem clamp(1rem, 2.5vw, 1.8rem); margin-top: 1rem; }
  /* on the home page the steps sit in a narrow column: one step per line, name left and what it does right, instead
     of cards that wrap two and one */
  .flow { flex-direction: column; flex-wrap: nowrap; gap: 0.3rem; }
  .flow > li { flex: none; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0 0.8rem; align-items: baseline; padding-block: 0.4rem 0.45rem; }
  .flow > li + li::before { content: '↓'; left: -1.1rem; top: -0.15rem; }
  .points { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 52rem) {
    .points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow > li { grid-template-columns: minmax(0, 1fr); }
  }
  .refs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.7rem; }
  .refs li { display: grid; gap: 0.15rem; align-content: start; padding: 0.7rem 0.9rem 0.8rem; border: 1px solid var(--rule); border-radius: 8px; background: var(--raise); }
  .refs a { font-size: 1.15rem; font-stretch: 112%; font-weight: 620; width: fit-content; }
  .refs .note { font-size: 0.9rem; }

  @media (max-width: 62rem) { .tldr-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 52rem) {
    .setup, .split, .clips { grid-template-columns: minmax(0, 1fr); }
    .stats { grid-template-columns: minmax(0, 1fr); }
    .cams { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .rig { width: auto; max-width: 26rem; }
    .rig img { width: 100%; height: auto; }
  }
</style>
