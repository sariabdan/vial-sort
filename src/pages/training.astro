---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import training from '../data/training.json';
import gate from '../data/gate.json';
import registry from '../data/registry.json';
import { url, MODELS } from '../lib/site';
import { PROBE } from '../lib/probe';

// Training as a panel (the style of Results): the runs on the left, ticked to put their loss curves on one chart per
// kind of model; the offline tests and what they found in tabs beside it. src/charts/training.ts draws the charts.
const reg = (run: string) => registry.models.find((m) => m.run === run);
const gc = gate.checkpoints;
const last = gc[gc.length - 1];
const leavesHome = gc.every((g) => g.go_ok === g.go_of);
const bestDest = Math.max(...gc.map((g) => g.dest_frames));
const sourceFrom = (gc.find((g, i) => gc.slice(i).every((h) => h.source)) ?? last).step;
const gated = reg('pi05-canon')!;
const nameOf = (run: string) => reg(run)?.name ?? run;
const k = (s: number) => `${s / 1000}k`;
// a model's rows on Results: its rollouts are shown there, not here
const resultsOf = (run: string) => { const m = reg(run); return m && m.rows.length ? `${url('results/')}?r=${m.rows.join(',')}#h-score` : null; };
// one colour per run, in a fixed order, the same in the list, the chart and the table (src/charts/training.ts reads it)
const SERIES = ['pi05', 'flux', 'groot', 'pi0', 'act', 'isaac'];
const colorOf = (i: number) => `var(--m-${SERIES[i % SERIES.length]})`;
const runs = training.runs.map((run, i) => ({ run, m: reg(run.id)!, color: colorOf(i) }));
---
<Base
  page="training"
  title="Training"
  description="How each model's training loss fell, and offline tests of what a π0.5 model reads from its command."
>
  <div class="wrap panel-page" data-no-onpage>
    <header class="panel-head">
      <h1>Training</h1>
      <p class="note">
        {`How each model's training loss fell, and offline tests of what a model reads from its command. What each model is: `}
        <a href={url('models/')}>Models</a>{` · how it did on the robot: `}<a href={url('results/')}>Results</a>
      </p>
    </header>

    <div class="panel-split">
      <aside class="runs" aria-label="Runs whose loss curves are drawn">
        <p class="list-head" aria-hidden="true"><span>Run</span><span>Steps</span><span>Hours</span></p>
        {runs.map(({ run, m, color }) => (
          <label class="run" title={`${m.name}: ${run.steps.toLocaleString('en-GB')} steps in ${run.hours} hours`}>
            <input type="checkbox" data-run-box={run.id} checked />
            <i style={`background: ${color}`}></i>
            <span class="nm">{m.name}<span class="fam">{MODELS[run.model].label}</span></span>
            <span class="num">{k(run.steps)}</span>
            <span class="num">{run.hours}</span>
          </label>
        ))}
        <p class="list-actions">
          <button type="button" class="quiet-btn" data-runs="all">All</button>
          <button type="button" class="quiet-btn" data-runs="none">None</button>
        </p>
        <p class="note list-foot">The ticks choose the curves on the first tab. A swatch is that run's colour in the chart.</p>
      </aside>

      <div class="view" data-tabset data-await>
        <div class="tabstrip" role="tablist" aria-label="Parts of training">
          <button type="button" role="tab" data-t="loss" aria-selected="true">Loss curves</button>
          <button type="button" role="tab" data-t="offline" aria-selected="false">Offline tests</button>
          <button type="button" role="tab" data-t="why" aria-selected="false">Why the destination fails</button>
          <button type="button" role="tab" data-t="finetunes" aria-selected="false">Short fine-tunes</button>
        </div>

        <section data-p="loss" id="loss">
          <p class="note lead-in">
            One chart per kind of model, because each kind measures its loss differently; runs of one kind share an axis.
            There is no validation loss: every demonstration has its own wording, so a curve cannot show when a model starts to memorise. The robot is the only test.
          </p>
          <div class="charts" data-loss style="min-height: 220px"></div>
          <p class="note empty" data-loss-empty hidden>Nothing is ticked. Tick a run in the list.</p>
          <div class="table-scroll">
            <table class="data facts-table">
              <thead><tr><th>Run</th><th>Model</th><th class="r">Steps</th><th class="r">Training time</th><th class="r">Per step</th><th class="r">Peak GPU memory</th><th></th></tr></thead>
              <tbody>
                {runs.map(({ run, m, color }) => (
                  <tr data-run-row={run.id}>
                    <th scope="row"><i style={`background: ${color}`}></i>{m.name}</th>
                    <td>{MODELS[run.model].label}</td>
                    <td class="r num">{k(run.steps)}</td>
                    <td class="r num">{`${run.hours} h`}</td>
                    <td class="r num">{`${run.step_s} s`}</td>
                    <td class="r num">{`${run.mem_gb} GB`}</td>
                    <td class="links"><a href={`${url('models/')}#${m.id}`}>settings</a>{resultsOf(run.id) && <>{' · '}<a href={resultsOf(run.id)!}>on the robot</a></>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section data-p="offline" hidden>
          <h2>What {gated.name} could read, without the robot</h2>
          <p>
            {`An offline test of every saved checkpoint of ${gated.name}, from 1k to ${last.step / 1000}k steps. It is shown frames from the demonstrations and from real ` +
              `rollouts and asked what motion it would predict.`}
          </p>
          <ul class="points">
            {leavesHome && <li class="pass"><b>It leaves home</b><span>At every checkpoint.</span></li>}
            <li class="pass"><b>Its reach follows the source slot</b><span>{`From ${sourceFrom / 1000}k steps on, its reach follows the source slot named in the command.`}</span></li>
            <li class="fail">
              <b>It does not follow the destination slot</b>
              <span>{bestDest === 0
                ? `It passed none of the ${last.dest_of} destination frames at any checkpoint.`
                : `At no checkpoint did it pass more than ${bestDest} of ${last.dest_of} destination frames.`}</span>
            </li>
          </ul>
          <div class="offline-grid">
            <Figure id="gate-error" title="Error against the recorded demonstrations" height={200}
              description="Degrees between the checkpoint's predicted motion while placing and the recorded one, on 15 demonstrations.">
              <ul class="legend" slot="legend">
                <li><i style="background: var(--m-pi05)"></i>Insertion error</li>
                <li><i style="background: var(--steel)"></i>Gripper error</li>
              </ul>
              <table class="data" slot="table">
                <thead><tr><th>Checkpoint</th><th class="r">Insertion error (°)</th><th class="r">Gripper error (°)</th></tr></thead>
                <tbody>
                  {gc.map((g) => <tr><td class="num">{g.step / 1000}k</td><td class="r">{g.insertion_err}</td><td class="r">{g.gripper_err}</td></tr>)}
                </tbody>
              </table>
              <p slot="notes" class="note">The errors fall steadily. The checks beside it do not move the same way.</p>
            </Figure>
            <div class="table-scroll gate">
              <table class="data" aria-label="Offline checks by checkpoint">
                <thead><tr><th>Check</th>{gc.map((g) => <th class="r">{g.step / 1000}k</th>)}</tr></thead>
                <tbody>
                  <tr>
                    <th scope="row" title="Shown the first frame of nine real rollouts, with the arm at home, does it predict a move away? Counted when all three random seeds do. Frames from the start of a demonstration move 55 to 90°; a model that will sit still moves a few degrees.">Leaves home</th>
                    {gc.map((g) => <td class="r"><span class={g.go_ok === g.go_of ? 'ok' : 'bad'}>{g.go_ok}/{g.go_of}</span></td>)}
                  </tr>
                  <tr>
                    <th scope="row" title="Vials stand in right-rack slots 1, 3 and 6 and the command names each in turn. The predicted shoulder angle 1.7 s ahead must order the slots as the demonstrations do (1 furthest, then 3, then 6) with at least 15° between the ends.">Reach follows the source slot</th>
                    {gc.map((g) => <td class="r"><span class={g.source ? 'ok' : 'bad'}>{g.source ? 'yes' : 'no'}</span></td>)}
                  </tr>
                  <tr>
                    <th scope="row" title="“From position 3 … to slot 1” and “from position 1 … to slot 3” use the same two numbers. A model that understands which is the source reaches differently for them, by at least 8°; one that only collects the numbers does not.">Binds the two numbers to their roles</th>
                    {gc.map((g) => <td class="r"><span class={g.roles ? 'ok' : 'bad'}>{g.roles ? 'yes' : 'no'}</span></td>)}
                  </tr>
                  <tr>
                    <th scope="row" title={`${last.dest_of} frames taken one second after a grasp, the same vial each time, with commands that ask for destination slot 1, 3 and 6. A frame passes when the predicted reach is ordered as in the demonstrations, by at least 10°. The check passes when at least 4 of the ${last.dest_of} frames do. “0/${last.dest_of}” is a real count: no frame passed, at any checkpoint.`}>Reads the destination slot</th>
                    {gc.map((g) => <td class="r"><span class={g.dest ? 'ok' : 'bad'}>{g.dest_frames}/{g.dest_of}</span></td>)}
                  </tr>
                </tbody>
              </table>
              <p class="note">Hover a check for exactly what it tests.</p>
            </div>
          </div>
        </section>

        <section data-p="why" hidden>
          <h2>Why the destination is not followed</h2>
          <p>
            {`On 21 October a probe on training frames answered “underfit, overfit, or what?”: neither. The model had learned a shortcut ` +
              `from how the 100 demonstrations were recorded, one destination per sitting (`}<a href={url('datasets/#ws220')}>on the Data page</a>{`):`}
          </p>
          <ol class="flow plain">
            <li><b>The camera picture</b><span>says which sitting a frame is from.</span></li>
            <li><b>The sitting</b><span>says the destination, because each sitting had only one.</span></li>
            <li><b>The destination</b><span>is therefore read off the picture, and the words that name it are not needed.</span></li>
          </ol>
          <ul class="points">
            <li><b>Why the source slot was learned and the destination was not</b><span>The source changed within a sitting, so the picture could not give it away.</span></li>
          </ul>
          <div class="probe">
            <p class="probe-head" aria-hidden="true"><span>Test, on training frames</span><span>12k steps</span><span>2k</span></p>
            {PROBE.map((p) => (
              <p class="probe-row">
                <span class="t">{p.test}</span>
                <span class="bar"><i style={`width: ${p.at12k}%`}></i></span>
                <b class="num">{p.at12k}%</b>
                <span class="num then">{p.at2k}%</span>
              </p>
            ))}
          </div>
          <ul class="points">
            <li><b>Not overtraining</b><span>The result is the same at 2k and 12k steps.</span></li>
            <li><b>The destination words do nothing</b><span>Without a command the model behaves as if the destination words were not there.</span></li>
            <li class="quiet"><b>How the probe was run</b><span>{`On 21 October, on 24 pairs of demonstrations with the same source and different destinations, for ${gated.name}. It is written up in the project notes.`}</span></li>
          </ul>
        </section>

        <section data-p="finetunes" hidden>
          <h2>The two short fine-tunes</h2>
          <ul class="points">
            <li><b>What they are</b><span>{`${nameOf('pi05-noop')} and ${nameOf('pi05-trim2')} are quick fine-tunes of ${nameOf('pi05-allcams')} at 12k.`}</span></li>
            <li><b>What changed in their data</b><span>Both train on demonstrations with the idle start and end cut, and replace the first frames with views of the arm with nobody near it; the second uses a corrected cut.</span></li>
            <li><b>What they test</b><span>The finding of the 19 October probes: the 12k checkpoint often waited at its start pose because it had learned the operator leaning in as its cue to move.</span></li>
          </ul>
          <p>{['pi05-noop', 'pi05-trim2'].map((r, i) => resultsOf(r) && <>{i ? ' · ' : ''}<a href={resultsOf(r)!}>{`${nameOf(r)} on the robot →`}</a></>)}</p>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import '../charts/training';
</script>

<style>
  .lead-in { max-width: 60rem; margin-bottom: 0.6rem; }
  /* the list of runs: one line each, a tick and the run's colour */
  .runs { position: sticky; top: 0.5rem; display: grid; min-width: 0; }
  .list-head, .run { display: grid; grid-template-columns: 1.1rem 0.8rem minmax(0, 1fr) 2.4rem 2.6rem; column-gap: 0.4rem; align-items: center; }
  .list-head { font-size: 0.75rem; color: var(--steel); padding: 0.2rem 0.3rem; border-bottom: 1px solid var(--rule); max-width: none; margin: 0; }
  .list-head span:first-child { grid-column: 1 / 4; }
  .list-head span:not(:first-child) { text-align: right; }
  .run { padding: 0.28rem 0.3rem; border-bottom: 1px solid var(--grid); border-radius: 4px; cursor: pointer; }
  .run:hover { background: var(--raise); }
  .run:has(input:checked) { background: var(--raise); }
  .run input { accent-color: var(--ink); margin: 0; cursor: pointer; }
  .run i { width: 0.7rem; height: 0.25rem; border-radius: 2px; }
  .run:not(:has(input:checked)) i { opacity: 0.35; }
  .run .nm { font-weight: 620; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .run .fam { font-weight: 400; font-size: 0.78rem; color: var(--ink-2); margin-left: 0.4rem; }
  .run .num { text-align: right; font-size: 0.82rem; color: var(--ink-2); }
  .list-actions { display: flex; gap: 0.3rem; margin: 0.6rem 0 0; }
  .list-actions .quiet-btn { font-size: 0.8rem; padding: 0.05rem 0.55rem; }
  .list-foot { margin-top: 0.5rem; }
  .view { min-width: 0; }
  .empty[hidden] { display: none; }
  .charts { display: grid; gap: 0.6rem; }
  .charts :global(h3) { margin: 0; font-size: 0.85rem; font-weight: 620; }
  .charts :global(h3 span) { font-weight: 400; color: var(--ink-2); }
  .facts-table { margin-top: 0.8rem; width: 100%; }
  .facts-table th[scope='row'] { white-space: nowrap; font-weight: 620; }
  .facts-table th i { display: inline-block; width: 0.7rem; height: 0.25rem; border-radius: 2px; margin-right: 0.45rem; vertical-align: middle; }
  .facts-table tr[hidden] { display: none; }
  .facts-table .links { white-space: nowrap; font-size: 0.82rem; }
  .offline-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.2rem; align-items: start; margin-top: 0.9rem; }
  .offline-grid :global(.figure) { max-width: 40rem; }
  @media (min-width: 100rem) { .offline-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); } }
  .gate th[scope='row'] { font-weight: 560; cursor: help; text-decoration: underline dotted; text-underline-offset: 0.2em; }
  .gate .note { margin-top: 0.5rem; }
  /* the probe: one bar per test, the 12k value drawn, the 2k value beside it */
  .probe { display: grid; gap: 0.35rem; margin: 0.9rem 0; max-width: 52rem; }
  .probe-head, .probe-row { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(6rem, 1fr) 3rem 3rem; gap: 0.8rem; align-items: center; margin: 0; max-width: none; }
  .probe-head { font-size: 0.75rem; color: var(--steel); }
  .probe-head span:nth-child(2) { grid-column: 2 / 4; text-align: right; }
  .probe-head span:last-child, .probe-row .then, .probe-row b { text-align: right; }
  .probe-row .t { font-size: 0.88rem; }
  .probe-row .bar { height: 0.9rem; background: var(--grid); border-radius: 3px; overflow: hidden; }
  .probe-row .bar i { display: block; height: 100%; background: var(--accent); }
  .probe-row .then { color: var(--ink-2); font-size: 0.85rem; }
  @media (max-width: 56rem) { .runs { position: static; } }
</style>
