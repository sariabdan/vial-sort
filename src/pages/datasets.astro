---
import Base from '../layouts/Base.astro';
import CoverageMatrix from '../components/CoverageMatrix.astro';
import CameraChips from '../components/CameraChips.astro';
import Term from '../components/Term.astro';
import SlotVials from '../components/SlotVials.astro';
import RackGlyph from '../components/RackGlyph.astro';
import results from '../data/results.json';
import october from '../data/october.json';
import ws220 from '../data/ws220.json';
import datasets from '../data/datasets.json';
import media from '../data/media.json';
import experiments from '../data/experiments.json';
import { url, HF, visualizer, date, CAMERA_NAMES, andList, demoSet } from '../lib/site';

const cov = october.coverage;
const c2 = ws220;
const b2 = c2.batches as Record<string, { episodes: number; frames: number; first: string | null; last: string | null }>;
const R220 = 'sari-abdan/vial-sort-slots-220', R51 = 'sari-abdan/vial-sort-contrast-51', R99 = 'sari-abdan/vial-sort-contrast-99-depth';
const demo = media.demo_ws100;
const runs = datasets.datasets.filter((d) => d.kind === 'rollout');
const minutes = (frames: number | null, fps: number | null) => (frames && fps ? Math.round(frames / fps / 60) : null);
const w = cov.wordings;
const pools = cov.pools;
const trainedOn = (set: string) => andList(experiments.models.filter((m) => demoSet(m.data) === set).map((m) => m.name));
// The page is a panel with tabs (the style of Results). Its first tab shows the two training sets as two rows of
// vials, one per slot, in the same two columns, so the sets compare slot by slot.
// what each coloured part of a command is called under the sentence on the Commands tab, with the size of its pool
const PART: Record<string, string> = {
  verb: `verb · ${pools.verb.length}`, obj: `object · ${pools.object.length}`, slot: `slot · ${pools.slot_count}`,
  rack: `rack · ${pools.rack.left.length}`, bin: `bin · ${pools.bin.length}`, tmpl: 'form',
};
const demoSets = results.demo_sets as Record<string, { episodes: number; per_source: Record<string, number>; per_destination: Record<string, number> }>;
const sets = [
  { anchor: 'set-100', repo: 'sari-abdan/vial-sort-slots-100', episodes: cov.episodes, moves: Object.keys(cov.demos).length, minutes: cov.minutes, frames: cov.frames,
    recorded: 'Recorded 14 October 2026', how: 'Twenty runs of five, one destination per run; no move inside one rack.',
    trained: trainedOn('100'), demos: demoSets['vial-sort-slots-100'] },
  { anchor: 'set-220', repo: R220, episodes: c2.episodes, moves: c2.moves, minutes: c2.minutes, frames: c2.frames,
    recorded: '70 of the 100, then 51 on 28 October and 99 on 3 November',
    how: `One layout recorded three times, to three different destinations; ${c2.same_rack} demonstrations inside one rack.`,
    trained: trainedOn('220'), demos: demoSets['vial-sort-slots-220'] },
].filter((s) => s.demos);

const cams = [
  { key: 'top_down', text: 'The only high-angle view. It sees both racks, the bin and the arm at once, with no people in it.' },
  { key: 'left_top', text: 'High, across the table. The operator is in view in every frame, on purpose: someone usually stands there during a rollout too.' },
  { key: 'left_bottom', text: 'Near table level, the colour stream of a RealSense camera. The vials look largest here and which holes hold a vial can be read.' },
  { key: 'right', text: 'A wide view of the workspace from the other side. A person is in view some of the time.' },
  { key: 'wrist', text: 'Close up, mounted on the gripper. The vial fills the frame during a grasp.' },
];

// the sizes of the pools the wordings are drawn from, and what they multiply to
const verbs = pools.verb.length, objects = pools.object.length, templates = pools.template.length;
const slotForms = pools.slot_count, rackForms = pools.rack.left.length, binForms = pools.bin.length;
const rackToRack = verbs * objects * (slotForms * rackForms) * (slotForms * rackForms) * templates;
const toBin = verbs * objects * (slotForms * rackForms) * binForms * templates;
const sci = (n: number) => {
  const e = Math.floor(Math.log10(n));
  return `${(n / 10 ** e).toFixed(1)} × 10${'⁰¹²³⁴⁵⁶⁷⁸⁹'.split('')[e] ?? `^${e}`}`;
};
const pool = [
  { cls: 'verb', name: 'Verb', n: verbs, values: pools.verb.join(', ') },
  { cls: 'obj', name: 'Object', n: objects, values: pools.object.join(', ') },
  { cls: 'slot', name: 'Slot', n: slotForms, values: `for slot 3: ${pools.slot['3'].join(', ')}` },
  { cls: 'rack', name: 'Rack', n: rackForms, values: pools.rack.left.join(', ') + ' (and the same for the right)' },
  { cls: 'bin', name: 'Bin', n: binForms, values: pools.bin.join(', ') },
  { cls: 'tmpl', name: 'Sentence form', n: templates, values: pools.template.join('; ') },
];

// mark each part of a real wording by the pool it came from
const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const alt = (xs: string[]) => [...new Set(xs)].sort((a, b) => b.length - a.length).map(esc).join('|');
const allSlots = Object.values(pools.slot).flat();
const allRacks = [...pools.rack.left, ...pools.rack.right];
const WORDING = new RegExp(
  `^(${alt(pools.verb)}) (${alt(pools.object)}) (from|in|at) (${alt(allSlots)}) of (${alt(allRacks)}) (to|over to|into) ` +
    `(?:(${alt(allSlots)}) of (${alt(allRacks)})|(${alt(pools.bin)}))\\.$`,
);
type Part = { text: string; cls?: string };
const parts = (sentence: string): Part[] => {
  const m = WORDING.exec(sentence);
  if (!m) return [{ text: sentence }];
  const [, v, o, t1, s1, r1, t2, s2, r2, b] = m;
  return [
    { text: v, cls: 'verb' }, { text: ' ' }, { text: o, cls: 'obj' }, { text: ' ' }, { text: t1, cls: 'tmpl' }, { text: ' ' },
    { text: s1, cls: 'slot' }, { text: ' of ' }, { text: r1, cls: 'rack' }, { text: ' ' }, { text: t2, cls: 'tmpl' }, { text: ' ' },
    ...(b ? [{ text: b, cls: 'bin' }] : [{ text: s2, cls: 'slot' }, { text: ' of ' }, { text: r2, cls: 'rack' }]), { text: '.' },
  ];
};
---
<Base
  page="datasets"
  title="Data"
  description="The teleoperated demonstrations, 100 behind the October models and 220 behind the November ones: the five cameras, which moves were recorded and which were held out, how the commands were worded, and every robot recording, public on Hugging Face."
>
  <div class="wrap panel-page" data-no-onpage data-tabset data-await>
    <header class="panel-head">
      <h1>Data</h1>
      <p class="note">
        Five cameras watched a person move a vial with a leader arm. Two training sets, 100 and 220 demonstrations, and every robot
        recording are public on Hugging Face in the LeRobot format.
      </p>
    </header>
    <div class="tabstrip" role="tablist" aria-label="Parts of the data">
      <button type="button" role="tab" data-t="sets" aria-selected="true">Cameras, command, demonstrations</button>
      <button type="button" role="tab" data-t="commands" aria-selected="false">Command wording</button>
      <button type="button" role="tab" data-t="moves" aria-selected="false">Move by move</button>
      <button type="button" role="tab" data-t="how" aria-selected="false">How it was recorded</button>
      <button type="button" role="tab" data-t="recordings" aria-selected="false">Robot recordings</button>
    </div>

    <section data-p="sets" id="sets">
      <div class="seen-split">
      <aside class="seen">
        <p class="blk-h">What the model sees<span>five cameras</span></p>
        <div class="viewer" data-viewer>
          {cams.map((c, i) => (
            <figure class="big" data-cam={c.key} hidden={i > 0}>
              <img src={url(`img/cams/${c.key}.webp`)} width="640" height="480" loading={i ? 'lazy' : 'eager'} alt={`${CAMERA_NAMES[c.key]}: ${c.text}`} />
              <figcaption><b>{CAMERA_NAMES[c.key]}</b><span class="key">{c.key}</span><span class="what">{c.text}</span></figcaption>
            </figure>
          ))}
          <div class="thumbs" role="group" aria-label="Choose a camera view">
            {cams.map((c, i) => (
              <button type="button" data-cam-pick={c.key} aria-pressed={i === 0 ? 'true' : 'false'} title={CAMERA_NAMES[c.key]}>
                <img src={url(`img/cams/${c.key}.webp`)} width="640" height="480" loading="lazy" alt="" />
                <span>{CAMERA_NAMES[c.key]}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="note cam-note">One instant of one demonstration, seen by each camera. All five are recorded at 30 frames a second. Pick a view to enlarge it.</p>
      </aside>
      <div class="seen-main">

      <p class="blk-h">What it is told<span>one sentence</span></p>
      <div class="told">
        <p class="sentence">
          {parts(w.example[0]).map((p) => (p.cls
            ? <span class="part"><span class={`tag ${p.cls}`}>{p.text}</span><small>{PART[p.cls]}</small></span>
            : <span class="part plain"><span>{p.text}</span><small>&nbsp;</small></span>))}
        </p>
        <ul class="told-facts">
          <li><b>By position, never by colour</b><span>so a command stays unambiguous when two vials share a colour.</span></li>
          <li><b class="num">{`${w.distinct} wordings across ${w.moves} moves`}</b><span>{`drawn from ${rackToRack.toLocaleString('en-GB')} possible for one move, so repeats of a move are phrased differently.`}</span></li>
          <li><a href="#commands">How the commands are worded →</a></li>
        </ul>
      </div>

      <p class="blk-h">What it learned from<span>demonstrations, slot by slot</span></p>
      <ul class="legend set-key" aria-label="How to read the vials">
        <li class="key-lead">A vial fills to the number of demonstrations at that slot, against the most in its row:</li>
        <li><i class="kv"><i></i></i>demonstrations</li>
        <li><i class="kv kh"><i></i></i>none: a held-out slot, kept back so a model can be tested on it</li>
        <li>Slots 1 to 6, left to right.</li>
      </ul>
      <div class="sets-table">
        <div class="st-row st-head" aria-hidden="true">
          <span class="st-who"></span>
          <div class="st-cap"><p><b>Start in</b><span>the slot the vial is taken from</span></p><div class="caps"><span class="c6">left rack</span><span class="c6">right rack</span></div></div>
          <div class="st-cap"><p><b>End in</b><span>the slot the vial is put in</span></p><div class="caps"><span class="c6">left rack</span><span class="cb">bin</span><span class="c6">right rack</span></div></div>
        </div>
        {sets.map((s) => (
          <div class="st-row" id={s.anchor}>
            <div class="st-who">
              <p class="st-name"><i></i><a href={`${HF}/datasets/${s.repo}`}>{s.repo.split('/')[1]}</a></p>
              <p class="st-big"><b class="num">{s.episodes}</b><span>demonstrations</span></p>
              <p class="st-parts">{`${s.moves} moves · ${s.minutes} min · ${s.frames.toLocaleString('en-GB')} frames`}</p>
              <p class="st-parts">{s.recorded}</p>
            </div>
            <SlotVials demoOnly demos={s.demos} label={`${s.episodes} demonstrations`} />
            <p class="st-foot">{s.how}{s.trained && <>{' Trained: '}<b>{s.trained}</b>.</>}{' '}<a href={visualizer(s.repo)}>Watch any episode</a></p>
          </div>
        ))}
      </div>
      <p class="note after">
        Slots 2 and 5 are never a source, and slots 2, 4 and 5 are never a destination (slot 4 is only ever a source). The training set leaves
        the depth stream out: the November models see the five colour cameras only.
      </p>
      </div>
      </div>
    </section>

    <section data-p="moves" hidden>
      <p class="note lead-in">
        {`Rows are the slot the vial started in, columns where it was put, and each number is how many demonstrations there are of that move. `}
        <Term k="heldout">Held-out</Term>{` slots are hatched: they were never recorded, so a model can be tested on them.`}
      </p>
      <div class="two-up">
        <div>
          <h2>{`The ${cov.episodes} demonstrations`}</h2>
          <CoverageMatrix demos={cov.demos} slots={cov.slots} heldSources={cov.heldout_sources} heldDestinations={cov.heldout_destinations} />
          <p class="note after">{`${Object.keys(cov.demos).length} different moves; 75 go from one rack to the other and 25 to the bin. No move stays inside a rack.`}</p>
        </div>
        <div>
          <h2>{`The ${c2.episodes} demonstrations`}</h2>
          <CoverageMatrix demos={c2.demos} slots={c2.slots} heldSources={c2.heldout_sources} heldDestinations={c2.heldout_destinations} />
          <p class="note after">
            {`${c2.moves} different moves; ${c2.to_bin} go to the bin and ${c2.same_rack} stay inside one rack. One gap: no demonstration goes from L1 to L6.`}
          </p>
        </div>
      </div>
    </section>

    <section data-p="how" hidden>
      <div class="two-up">
        <div>
          <h2>{`The ${cov.episodes}, on one afternoon`}</h2>
          <p>
            {`Recorded on 14 October. Each demonstration is one `}<Term k="move">move</Term>{`: take the vial from one slot and put it in another slot or the bin.`}
          </p>
          <ul class="points two">
            <li><b>Twenty runs of five</b><span>Each run in one sitting, with one destination per run.</span></li>
            <li><b>Always from the other rack</b><span>For a rack destination the vial always starts in the other rack.</span></li>
            <li><b>Colour never identifies the vial</b><span>Three vial colours, red, cyan and dark green. In 95 of the 100 scenes a second vial of the target’s colour stands on the source rack; the 5 exceptions are the first run.</span></li>
            <li><b>The bin moves</b><span>To a new spot every ten demonstrations, with small nudges in between. The first frame of every demonstration is saved so each spot is on record.</span></li>
            <li><b>The light fades</b><span>The room got darker through the afternoon. The side cameras are almost black in demonstrations 75 to 99; the overhead camera stays readable.</span></li>
            <li><b>The operator is in view</b><span>The arm is homed before every demonstration, and at the start the operator leans over the robot, so the person is in the wrist and across-the-table views.</span></li>
            <li class="quiet"><b>Three recorded again</b><span>The wrist camera dropped off the bus three times (demonstrations 47, 53 and 60). Those three were recorded again.</span></li>
          </ul>
        </div>
        <div id="ws220">
          <h2>{`The ${c2.episodes}, so only the command names the destination`}</h2>
          <ul class="points two">
            <li class="fail"><b>The 100: the picture gave the destination away</b><span>Every run of five had one destination and was recorded in one sitting, so the pictures gave the destination away and the models learned to read it there.</span></li>
            <li class="pass"><b>The 150 new: only the command differs</b><span>One layout is recorded three times in a row with three different destinations, so only the command can tell them apart.</span></li>
          </ul>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>Part</th><th>Recorded</th><th class="r">Episodes</th><th class="r">Frames</th><th>Also published alone</th></tr></thead>
              <tbody>
                <tr><td>The first 70 of the 100 (runs 15 to 20 were too dark and were dropped)</td><td>14 October</td><td class="r">{b2.ws100.episodes}</td><td class="r">{b2.ws100.frames.toLocaleString('en-GB')}</td><td><a href={`${HF}/datasets/sari-abdan/vial-sort-slots-100`}>vial-sort-slots-100</a></td></tr>
                <tr><td>Three destinations per layout, first sitting</td><td>{date(b2.contrast.first ?? '')}</td><td class="r">{b2.contrast.episodes}</td><td class="r">{b2.contrast.frames.toLocaleString('en-GB')}</td><td><a href={`${HF}/datasets/${R51}`}>vial-sort-contrast-51</a></td></tr>
                <tr><td>Three destinations per layout, second sitting, with the RealSense depth stream as well</td><td>{date(b2['contrast+depth'].first ?? '')}</td><td class="r">{b2['contrast+depth'].episodes}</td><td class="r">{b2['contrast+depth'].frames.toLocaleString('en-GB')}</td><td><a href={`${HF}/datasets/${R99}`}>vial-sort-contrast-99-depth</a></td></tr>
              </tbody>
            </table>
          </div>
          <p class="note after">The across-the-table camera sits slightly differently in the first 70 than in the later 150, and it was knocked again on 4 November; see <a href={url('docs/a16000-arm-test-9nov.html')}>the note of 9 November</a>.</p>
        </div>
      </div>

      <h2 class="both-head">In both sets</h2>
      <div class="two-up">
        <div>
          <h3>Racks and slots</h3>
          <div class="rack-fig"><RackGlyph asked="R3->L6" vialAt="L6" size="hero" vial="red" /></div>
          <p class="note">The table as every page draws it, here with the move R3 → L6.</p>
          <ul class="points two">
            <li><b>Left and right are the arm's</b><span>{`The left rack is the rack to the left of the follower arm, which is the `}<strong>top</strong>{` rack in the overhead view, and the right rack is the bottom one.`}</span></li>
            <li><b>The bin</b><span>Sits between the two racks.</span></li>
            <li><b>Slot 1</b><span>Is the one nearest the arm.</span></li>
            <li class="quiet"><b>In August it was different</b><span>The left rack was the one on the left of the side camera.</span></li>
          </ul>
        </div>
        <div>
          <h3>One demonstration, seen by all five cameras</h3>
          {demo && (
            <figure class="demo">
              <video src={url(demo.src)} poster={url(demo.poster)} width={demo.w} height={demo.h} muted loop playsinline data-auto preload="metadata"
                aria-label="One demonstration, seen by all five cameras at once"></video>
              <figcaption class="note">{demo.caption} The large view is the overhead camera; the four small ones are, from the top left, across the table, near eye level, from the side and the wrist.</figcaption>
            </figure>
          )}
          <p class="note">This one is from the first 100; the 220 were recorded with the same five cameras.</p>
        </div>
      </div>
    </section>

    <section data-p="commands" hidden>
      <div class="two-up">
        <div>
          <h2>A command, part by part</h2>
          <figure class="anatomy">
            <p class="sentence">
              {parts(w.example[0]).map((p) => (p.cls
                ? <span class="part"><span class={`tag ${p.cls}`}>{p.text}</span><small>{PART[p.cls]}</small></span>
                : <span class="part plain"><span>{p.text}</span><small>&nbsp;</small></span>))}
            </p>
            <figcaption class="note">One recorded command for R3 → L6. Each coloured part is drawn from its own pool of forms.</figcaption>
          </figure>
          <p class="sum" aria-label={`${rackToRack.toLocaleString('en-GB')} wordings of one rack-to-rack move`}>
            <span class="f"><b class="num">{verbs}</b><small>verbs</small></span><i>×</i>
            <span class="f"><b class="num">{objects}</b><small>objects</small></span><i>×</i>
            <span class="f"><b class="num">{slotForms * rackForms}</b><small>{`source: ${slotForms} slot × ${rackForms} rack forms`}</small></span><i>×</i>
            <span class="f"><b class="num">{slotForms * rackForms}</b><small>destination</small></span><i>×</i>
            <span class="f"><b class="num">{templates}</b><small>sentence forms</small></span><i>=</i>
            <span class="f total"><b class="num">{rackToRack.toLocaleString('en-GB')}</b><small>{`wordings of one move (${toBin.toLocaleString('en-GB')} to the bin)`}</small></span>
          </p>
          <ul class="facts-3">
            <li><b>By position, never by colour</b><span>The source slot is named, so a command stays unambiguous when two vials share a colour. Choosing the vial is left to the person typing.</span></li>
            <li><b>Written once, afterwards</b><span>A run was recorded with its destination only. One script then read the recording sheet and rewrote every command. No video was touched.</span></li>
            <li><b>{`${w.distinct} wordings across ${w.moves} moves`}</b><span>{`Not random: the k-th demonstration of a move gets the k-th combination, so repeats are phrased differently, at most ${w.max_per_move} per move.`}</span></li>
          </ul>
        </div>
        <div>
          <h2>The wording pools</h2>
          <div class="table-scroll">
            <table class="data pools">
              <thead><tr><th>Part</th><th class="r">Forms</th><th>Values</th></tr></thead>
              <tbody>
                {pool.map((p) => (
                  <tr><th scope="row"><span class={`tag ${p.cls}`}>{p.name}</span></th><td class="r num">{p.n}</td><td class="vals">{p.values}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <h3>{`The ${w.example.length} recorded wordings of R3 → L6`}</h3>
          <ul class="examples">
            {w.example.map((e) => (
              <li>“{parts(e).map((p) => (p.cls ? <span class={`tag ${p.cls}`}>{p.text}</span> : p.text))}”</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section data-p="recordings" hidden>
      <p class="note lead-in">
        {`${runs.length} autonomous sessions on Hugging Face, ${runs.reduce((s, t) => s + t.episodes, 0)} rollouts, one episode per `}<Term k="rollout">rollout</Term>{`, with every camera the model saw. ` +
          `Filled chips are the cameras stored in that recording. The `}<a href={url('results/')}>results</a>{` score every session, including the ones not uploaded.`}
      </p>
      <div class="table-scroll rec-box">
        <table class="data recs">
          <thead><tr><th>Recording</th><th>Model</th><th>Uploaded</th><th class="r">Rollouts</th><th class="r">Minutes</th><th>Cameras recorded</th><th></th></tr></thead>
          <tbody>
            {runs.map((t) => (
              <tr>
                <td><a href={`${HF}/datasets/${t.id}`}>{t.name}</a></td>
                <td>{t.model ?? '–'}</td>
                <td>{date(t.updated)}</td>
                <td class="r num">{t.episodes}</td>
                <td class="r num">{minutes(t.frames, t.fps)}</td>
                <td><CameraChips used={t.cameras} label="Cameras recorded" /></td>
                <td><a href={visualizer(t.id)}>watch</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note after">The August datasets, versions 1 to 5, are under <a href={url('previous/data/')}>previous work</a>.</p>
    </section>
  </div>
</Base>

<script>
  // The camera viewer on the first tab: the small picture that is clicked, or reached with the keyboard, is shown large
  // with its name and what it sees. Without this script the first view stays large and the others stay small.
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((viewer) => {
    const bigs = [...viewer.querySelectorAll<HTMLElement>('[data-cam]')];
    const picks = [...viewer.querySelectorAll<HTMLElement>('[data-cam-pick]')];
    const show = (key: string) => {
      bigs.forEach((b) => (b.hidden = b.dataset.cam !== key));
      picks.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.camPick === key)));
    };
    picks.forEach((p) => {
      p.addEventListener('click', () => show(p.dataset.camPick!));
      p.addEventListener('focus', () => show(p.dataset.camPick!));
    });
  });
</script>

<style>
  .after { margin-top: 0.8rem; }
  .lead-in { max-width: 60rem; margin-bottom: 0.8rem; }
  .two-up { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .two-up p + p { margin-top: 0.6rem; }

  /* the two sets as rows of vials, in the same two columns, so they compare slot by slot (as the runs do on Results) */
  .set-key { margin: 0 0 0.7rem; font-size: 0.8rem; gap: 0.25rem 0.9rem; color: var(--ink-2); }
  .set-key .key-lead { color: var(--ink); font-weight: 620; }
