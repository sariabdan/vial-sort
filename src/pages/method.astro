---
import Base from '../layouts/Base.astro';
import StageLegend from '../components/StageLegend.astro';
import SlotVials from '../components/SlotVials.astro';
import Term from '../components/Term.astro';
import TeX from '../components/TeX.astro';
import ScoreFormula from '../components/ScoreFormula.astro';
import experiments from '../data/experiments.json';
import results from '../data/results.json';
import { url, andList } from '../lib/site';
import { scoreRun, pctOf, verdictText, workedPart, workedTex, totalTex, medianShare, pooled, RACK_SLOTS, TRAINED_SLOTS,
  HELD_OUT_SLOTS, MIN_PER_SLOT, PASS_MARK, WEAK_AT } from '../lib/score';

// Testing explains, Results shows (the page is called Testing; its address stays /method/). Every definition, rule and caveat lives here once; Results links to the anchors
// #scored, #score, #read and #caveats. No result is shown here except the one run the score is worked out on.
// What each model is lives on Models (models.astro); the words are on Glossary (glossary.astro).
const scored = results.total;
const lo = results.left_out;
const eye = results.eye as Record<string, number>;
const noted = andList(results.noted_models);
const sessions = new Set(experiments.rows.flatMap((r) => r.sessions)).size;
const rows = results.rows;
// the run the score is worked out on: the newest one scored from the operator's notes
const ex = [...rows].filter((r) => r.scored_by === 'notes').sort((a, b) => (b.days.at(-1) ?? '').localeCompare(a.days.at(-1) ?? ''))[0]
  ?? [...rows].sort((a, b) => b.rollouts - a.rollouts)[0];
const exScore = scoreRun(ex.by_destination);
const exTr = workedPart(ex.by_destination, TRAINED_SLOTS), exHo = workedPart(ex.by_destination, HELD_OUT_SLOTS);
const exTex = [workedTex('Trained', exTr), workedTex('Held-out', exHo), totalTex([exTr, exHo], exScore.total)].filter(Boolean) as string[];
const exPool = pooled(ex.by_destination);
const exMedian = medianShare(ex.by_destination);
// the same run, drawn as Results draws it, for "Reading the results"
const exDemos = ex.train_set ? (results.demo_sets as Record<string, { per_source: Record<string, number>; per_destination: Record<string, number> }>)[ex.train_set] ?? null : null;
const exZeros = RACK_SLOTS.filter((s) => {
  const v = ex.by_destination[s as keyof typeof ex.by_destination] as { rollouts: number; released: number } | undefined;
  return v?.rollouts && !v.released;
});
---
<Base
  page="method"
  title="Testing"
  description="How the rollouts were run and scored, how the score of a run is built, how to read the results, and what the numbers cannot say."
>
  <div class="wrap panel-page" data-no-onpage data-tabset data-await>
    <header class="panel-head">
      <h1>Testing</h1>
      <p class="note">
        {`How the models were tested and scored, and how to read the results. What each model is: `}<a href={url('models/')}>Models</a>{`. ` +
          `The numbers themselves: `}<a href={url('results/')}>Results</a>{`. The words: `}<a href={url('glossary/')}>Glossary</a>.
      </p>
    </header>
    <div class="tabstrip" role="tablist" aria-label="Parts of the method">
      <button type="button" role="tab" data-t="run" aria-selected="true">Running a rollout</button>
      <button type="button" role="tab" data-t="scored" aria-selected="false">Scoring a rollout</button>
      <button type="button" role="tab" data-t="score" aria-selected="false">The score of a run</button>
      <button type="button" role="tab" data-t="read" aria-selected="false">Reading the results</button>
      <button type="button" role="tab" data-t="caveats" aria-selected="false">What the numbers cannot say</button>
    </div>
    <section data-p="run" id="run">
      <div>
        <h2>How a rollout is run</h2>
        <p>
          {`A rollout is one autonomous attempt at one command. The robot is the follower arm of the SO-101 pair on the ` +
            `workstation, with the five cameras of the `}<a href={url('datasets/')}>Data page</a>{`, and nobody drives it.`}
        </p>
        <ol class="flow">
          <li><b>Home pose</b><span>The arm is moved to the pose every demonstration started from, so a crash in the previous session cannot shift “home”.</span></li>
          <li><b>The command</b><span>{`The command is the sentence the model trained on. From 21 October a short code (“R3 L1”) expands to the exact training wording; before that it was typed by hand.`}</span></li>
          <li><b>The run</b><span>A person starts the rollout. The model reads the camera images and the joint angles, aims for a control rate of 30 per second, and sends joint targets to the arm. A person stops it, or it ends when a camera drops off the bus.</span></li>
          <li><b>Replanning</b><span>
            {`The model replans every few dozen actions. In `}<Term k="sync">sync mode</Term>{` the arm waits for each replan, which ` +
              `limits π0.5 to about 24 to 26 actions a second; with `}<Term k="rtc">RTC</Term>{` it does not. FLUX has no RTC and ` +
              `ran at 15.5 a second in the one session whose rate was logged.`}
          </span></li>
          <li><b>Stored</b><span>Each session is stored as a LeRobot dataset with the cameras the model saw, one episode per rollout, and uploaded to Hugging Face.</span></li>
        </ol>
      </div>
    </section>

    <section data-p="scored" id="scored" hidden>
      <div>
        <h2>How a rollout is scored</h2>
        <p>{`The `}<Term k="scorer">scorer</Term>{` works from the arm, not the vial, in four steps:`}</p>
        <ol class="flow">
          <li><b>Read the joint angles</b><span>The scorer reads the arm’s joint angles. It cannot see the vial.</span></li>
          <li><b>Find the grasp and the release</b><span>It finds each moment the gripper closed on something and each moment it opened.</span></li>
          <li><b>Name the slot</b><span>It decides which slot the arm was at by matching its pose to the same moment of the demonstrations.</span></li>
          <li><b>Sort the rollout</b><span>Each rollout is put in the furthest of the three outcomes below that it reached.</span></li>
        </ol>
        <StageLegend defs />
        <ul class="points">
          <li>
            <span class="big">{scored}</span><b>rollouts are scored</b>
            <span>{`${results.untrained} of them on moves no demonstration contains (this includes the held-out slots).`}</span>
          </li>
          <li class="quiet">
            <b>Left out</b>
            <span>
              {`${lo.short} that ended within 3 seconds, ${lo.unreadable} whose command the scorer cannot read, ` +
                (lo.restart ? `${lo.earlier_scene} from an earlier layout of the table, and ${lo.restart} restarts of a move the operator noted once.`
                  : `and ${lo.earlier_scene} from an earlier layout of the table.`)}
            </span>
          </li>
          {noted && (
            <li>
              <b>Scored from the operator's notes instead</b>
              <span>
                {`${noted} are scored from the operator's notes at the robot instead of the scorer: one rollout per noted move, the ` +
                  `outcome as written, restarts counted inside their move, and a vial dropped in front of or behind the slot counts as ` +
                  `not in it. Results lists every note as written, under Every move.`}
              </span>
            </li>
          )}
          <li>
            <span class="big">{eye.checked}</span><b>also watched by a person</b>
            <span>
              {`Because the scorer reads the arm and not the vial, a person also watched ${eye.checked} of the rollouts scored from the arm: ` +
                `the vial was in the slot in ${eye.in_slot}, not in it in ${eye.not_in_slot} (those count as not in the asked slot, whatever ` +
                `the arm did), and could not be told in ${eye.unclear}.`}
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section data-p="score" id="score" hidden>
      <div>
      <h2>The score of a run</h2>
      <p>
        {`A run is one model at one checkpoint in one mode. Its score is built slot by slot, so every place on the table counts ` +
          `the same however many rollouts went there. It is the score of the `}<a href={url('results/#h-score')}>Results table</a>{`.`}
      </p>
      <ol class="steps">
        <li>For each of the 12 rack slots as the destination: the share of its rollouts that ended in the asked slot.</li>
        <li>
          <Term k="score">Total accuracy</Term>{`: the mean of those 12 shares. The bin is left out: it is an easy target and ` +
            `would lift the score. In machine-learning words, each share is that slot's `}<Term k="recall">recall</Term>{` and the ` +
            `total is the `}<Term k="balanced">balanced accuracy</Term>{`.`}
        </li>
        <li>
          <Term k="trainacc">Trained-slot accuracy</Term>{` and `}<Term k="heldacc">held-out accuracy</Term>{`: the same mean over ` +
            `slots 1, 3 and 6 of both racks, the destinations the demonstrations used, and over slots 2, 4 and 5, which no ` +
            `demonstration used as a destination.`}
        </li>
        <li>
          {`A run passes with at least ${MIN_PER_SLOT} rollouts at every one of the 12 slots and a total accuracy of at least ` +
            `${PASS_MARK * 100}%. With fewer than ${MIN_PER_SLOT} at any slot it is disqualified; its numbers are still shown, ` +
            `over the slots it was tried at.`}
        </li>
        <li>
          {`A slot where half or fewer of the rollouts ended in the asked slot is a `}<Term k="weak">weak slot</Term>{`. ` +
            `The score table lists them worst first, so it shows where the score is lost.`}
        </li>
      </ol>
      <ScoreFormula />

      <h3>In machine-learning words</h3>
      <ul class="points">
        <li><b>True positive <TeX tex={String.raw`\mathrm{TP}_s`} /></b><span>For a slot s: a rollout asked to end in s whose vial ended in s.</span></li>
        <li><b>False negative <TeX tex={String.raw`\mathrm{FN}_s`} /></b><span>A rollout asked for s whose vial ended anywhere else: at another slot, beside s, still in the gripper, or never picked up.</span></li>
        <li class="quiet"><b>No true negatives</b><span>Every rollout asks for some slot.</span></li>
        <li>
          <b>Why not plain accuracy</b>
          <span>
            {`Pooling every rollout instead of averaging the slots would let the slots a run was tried at most decide its score: ` +
              `${ex.label} has ${exPool.got} of ${exPool.n} pooled (${pctOf(exPool.got / exPool.n)}) against ${pctOf(exScore.total)} balanced.`}
          </span>
        </li>
      </ul>
      <TeX tex={String.raw`\text{balanced accuracy} = \frac{1}{12} \sum_{s \in S} \text{recall}_s \qquad ` +
        String.raw`\text{plain accuracy} = \frac{\sum_{s \in S} \mathrm{TP}_s}{\sum_{s \in S} \left(\mathrm{TP}_s + \mathrm{FN}_s\right)}`} display />
      <TeX tex={`\\text{pass} \\iff n_s \\ge ${MIN_PER_SLOT} \\text{ for every } s \\in S \\text{ and } \\text{Total} \\ge ${PASS_MARK * 100}\\,\\% ` +
        `\\qquad \\text{weak}(s) \\iff \\text{share}(s) \\le ${WEAK_AT * 100}\\,\\%`} display />
      <ul class="points">
        <li>
          <b>The mean, not the median</b>
          <span>
            {`The median hides slots that fail. Seven slots at 80% and five at 0% have a median of 80% but a ` +
              `mean of 47%` + (exMedian !== null ? `; ${ex.label}'s own ${exScore.tried} slot shares have a median of ${Math.round(exMedian)}% ` +
              `against a mean of ${pctOf(exScore.total)}${exZeros.length ? `, because ${exZeros.length} of its slots are at 0%` : ''}.` : '.')}
          </span>
        </li>
        <li>
          <b>{`The ${PASS_MARK * 100}% bar is on the mean, not on every slot`}</b>
          <span>
            {`${MIN_PER_SLOT} rollouts still leave room for luck. A slot that really works 80% of the time scores 6 of 10 or less ` +
              `about one time in eight, so a model that is really 80% good everywhere would show at least one slot below 7 of 10 ` +
              `about four times in five. The mean of 120 rollouts evens that out.`}
          </span>
        </li>
      </ul>

      <h3>Worked out on one run</h3>
      <p>
        {`${ex.label}, the newest run scored from the operator's notes. Each share sits over its slot and its count, ` +
          `in the asked slot of all rollouts asked for that slot.`}
      </p>
      {exTex.map((t) => <TeX tex={t} display />)}
      <p class="note">{`${verdictText(exScore)}.`}</p>

      </div>
    </section>

    <section data-p="read" hidden>
      <div>
      <h2 id="read">How to read the results</h2>
      <figure class="ex-fig">
        <figcaption>{`${ex.label}, as Results draws it`}</figcaption>
        <div class="ex-vials">
          <b>Picked up from</b><b>Placed into</b>
          <SlotVials bySource={ex.by_source} byDestination={ex.by_destination} demos={exDemos} label={ex.label} />
        </div>
      </figure>
      <ul class="points">
        <li><b>The table as it stands</b><span>Each run is drawn as the left rack, the bin and the right rack, with a vial in each of a rack's six slots, slot 1 on the left.</span></li>
        <li><b>Picked up from</b><span>Counts the rollouts whose vial started in that slot and how many picked up the right vial.</span></li>
        <li><b>Placed into</b><span>Counts the rollouts asked to end there and how many did.</span></li>
        <li><b>Fill, colour and count</b><span>A vial fills to that share, in teal when all got through, a lighter teal for half or more and orange for under half; with none it stays empty and its count is red. Under each vial is got through / tried.</span></li>
        <li><b>A dashed vial</b><span>A held-out slot, one the training set never used in that role: slots 2 and 5 as a source, and 2, 4 and 5 as a destination.</span></li>
        <li class="quiet"><b>Hovering a vial</b><span>Gives the number of demonstrations of that slot in that role.</span></li>
      </ul>
      <h3>The table of where every vial ended</h3>
      <ul class="points">
        <li><b>Which runs have one</b><span>{`For rows scored from the operator's notes, a `}<Term k="confusion">confusion matrix</Term>{` shows where every vial ended. Rows scored from the arm have no matrix: the arm cannot see where the vial ended.`}</span></li>
        <li><b>Rows and columns</b><span>A row is the slot asked for; a column is where the vial ended: at a slot (in it, or beside it when it was not the asked slot), beside the asked slot, still held, or never picked up.</span></li>
        <li><b>The outlined cell</b><span>On the diagonal, it counts the rollouts that ended in the asked slot, and the rest of the row are its misses.</span></li>
        <li><b>Recall</b><span>On the right: the share the score uses.</span></li>
        <li><b><Term k="precision">Precision</Term></b><span>{`At the bottom: how many of the vials that ended at a slot were asked to end there; a false positive `}<TeX tex={String.raw`\mathrm{FP}_s`} />{` is a vial that ended at s while another slot was asked.`}</span></li>
      </ul>
      <TeX tex={String.raw`\text{precision}_s = \frac{\mathrm{TP}_s}{\mathrm{TP}_s + \mathrm{FP}_s}`} display />
      </div>
    </section>

    <section data-p="caveats" id="caveats" hidden>
      <div>
      <h2>What the numbers cannot say</h2>
      <ul class="points">
        <li><b>They are small</b><span>{`The biggest run has ${Math.max(...rows.map((r) => r.rollouts))} rollouts and many have one to five, so one more good or bad rollout moves a run a long way.`}</span></li>
        <li><b>Not a controlled comparison</b><span>The runs differ in training data, length and mode.</span></li>
        <li><b>Not a planned evaluation</b><span>{`These were test runs made during development: ${sessions} sessions, uneven in the moves tried, with no fixed number of rollouts per move.`}</span></li>
        <li><b>Not comparable with August</b><span>{`For a person-scored evaluation of a different, earlier system see `}<a href={url('previous/results/')}>the August evaluation</a>{`; the two should not be compared.`}</span></li>
      </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  /* each tab is a short text at reading width; the formulas and the worked example keep their own width */
  section > div { max-width: 66rem; }
  section > div > p { max-width: 46rem; }
  /* one run drawn as on Results, as the example the points beside it explain */
  .ex-fig { margin: 0.6rem 0 0; padding: 0.8rem 1rem 0.7rem; border: 1px solid var(--rule); border-radius: 8px; background: var(--raise); width: fit-content; max-width: 100%; overflow-x: auto; }
  .ex-fig figcaption { font-weight: 620; margin-bottom: 0.5rem; }
  .ex-vials { --vw: 24px; --vh: 38px; --vgap: 12px; --vbin: 32px; display: grid; grid-template-columns: max-content max-content; gap: 0.3rem 1.6rem; align-items: end; }
  .ex-vials > b { font-size: 0.85rem; font-weight: 650; }
  section p + p { margin-top: 0.6rem; }
  .steps { margin: 0.7rem 0; padding-left: 1.3rem; display: grid; gap: 0.45rem; max-width: 46rem; }
  .after { margin-top: 0.8rem; }
  h3 { margin: 1.4rem 0 0.4rem; }
</style>
