---
import Base from '../layouts/Base.astro';
import SlotMaps from '../components/SlotMaps.astro';
import ScoreTable from '../components/ScoreTable.astro';
import StageLegend from '../components/StageLegend.astro';
import Clip from '../components/Clip.astro';
import MoveTable from '../components/MoveTable.astro';
import results from '../data/results.json';
import registry from '../data/registry.json';
import experiments from '../data/experiments.json';
import media from '../data/media.json';
import { moveLabel, url } from '../lib/site';
import { slotDemos, slotGot, untrainedSlots, byBounds, type SlotMap } from '../lib/rackmaps';
import { pctOf, MIN_PER_SLOT, PASS_MARK } from '../lib/score';

// Results shows results only. What a word means, how a rollout or a run is scored, and what the numbers cannot say are
// explained once, on Experiments, and linked from here.
const rows = results.rows;
const models = registry.models.filter((m) => rows.some((r) => r.model === m.id));
const stages = results.stages;
const demoSets = results.demo_sets as Record<string, { episodes: number; per_source: Record<string, number>; per_destination: Record<string, number> }>;
const FAMILY = { pi05: 'π0.5', flux3: 'FLUX 3 Action', isaac: 'Isaac 0.5' } as Record<string, string>;
// up to 8 untrained moves are named; more than that are counted, and listed under Move by move
const untrMoves = (m: Record<string, number>) => {
  const k = Object.keys(m);
  return k.length <= 8 ? k.map(moveLabel).join(', ') : `${k.length} different moves, each listed under Move by move`;
};
const slotRate = (by: Record<string, { rollouts: number; grasped_right: number; released: number }>, pick: 'grasped_right' | 'released') =>
  Object.fromEntries(Object.entries(by).map(([k, v]) => [k, { n: v.rollouts, ok: v[pick] }]));
// per row, in reading order for one column: demonstrations above rollouts, source first. Wide pages put the
// source maps on the left and the destination maps on the right (SlotMaps.astro).
const mapsOf = (r: (typeof rows)[number]): SlotMap[] => {
  const d = r.train_set ? demoSets[r.train_set] : null;
  return [
    ...(d ? [slotDemos(d.per_source, 'source', r.train_set!)] : []),
    slotGot(slotRate(r.by_source, 'grasped_right'), 'source', 'Picked up the right vial, by source slot', 'picked up the right vial',
      d ? untrainedSlots(d.per_source, 'source') : undefined),
    ...(d ? [slotDemos(d.per_destination, 'destination', r.train_set!)] : []),
    slotGot(slotRate(r.by_destination, 'released'), 'destination', 'In the asked slot, by destination', 'ended in the asked slot',
      d ? untrainedSlots(d.per_destination, 'destination') : undefined),
  ];
};
const clips = media.featured as (typeof media.featured)[number][];
const total = results.total;
const count = (r: (typeof rows)[number], key: string) => r.stages[key as keyof typeof r.stages];

// where every vial ended, for rows scored from the operator's notes (a confusion matrix)
type Conf = Record<string, Record<string, number>>;
const CM_SLOTS = [...['L1', 'L2', 'L3', 'L4', 'L5', 'L6'], 'bin', ...['R1', 'R2', 'R3', 'R4', 'R5', 'R6']];
const cmCols = [
  ...CM_SLOTS.map((s) => ({ k: s, label: s, extra: false, title: `Ended at ${s === 'bin' ? 'the bin' : s}` })),
  { k: 'beside', label: 'Dropped beside', extra: true, title: 'Dropped in front of or behind the asked slot' },
  { k: 'held', label: 'Never let go', extra: true, title: 'Carried the vial and never let go' },
  { k: 'none', label: 'Not picked up', extra: true, title: 'Never picked up the asked vial (or took another one)' },
];
const HEAT = [0.2, 0.4, 0.6, 0.8];  // share of the row: five steps of the blue ramp
const sumOf = (o: Record<string, number> = {}) => Object.values(o).reduce((a, b) => a + b, 0);
const colTotal = (c: Conf, k: string) => Object.values(c).reduce((a, r) => a + (r[k] ?? 0), 0);
const endedAt = (k: string, s: string) =>
  k === s ? 'ended in it' : k === 'beside' ? 'dropped beside it' : k === 'held' ? 'never let go'
    : k === 'none' ? 'never picked up the right vial' : `ended at ${k === 'bin' ? 'the bin' : k}`;

// Move by move: each row's moves (experiments.json), with its model's "On the robot" note above its biggest row
const expRow = new Map(experiments.rows.map((r) => [r.key, r]));
const biggestOf = new Map<string, (typeof rows)[number]>();
for (const r of rows) {
  const b = biggestOf.get(r.model);
  if (!b || r.rollouts > b.rollouts) biggestOf.set(r.model, r);
}
const storyOf = (r: (typeof rows)[number]) => biggestOf.get(r.model)?.key === r.key
  ? (experiments.models.find((m) => m.id === r.model)?.notes ?? []).filter((n) => /^On the robot/i.test(n.title)) : [];
---
<Base
  page="results"
  title="Results"
  description="Every model on the robot: the score of each run, how far its rollouts got, where its vials ended, the rollouts themselves and every move it was asked."
>
  <section class="section head">
    <div class="wrap">
      <h1>Results</h1>
      <p class="lead">
        {`Every model on the robot. Tick models and checkpoints on the left; every table, map and video below follows. A row is ` +
          `one model at one checkpoint in one mode. These are test runs made during development, not a planned evaluation: `}
        <a href={url('experiments/#caveats')}>what the numbers cannot say</a>.
      </p>
    </div>
  </section>

  <div class="wrap work">
    <aside class="rail" aria-label="Choose what to compare">
      <details open class="rail-box">
        <summary><h2>Compare</h2><span class="count" id="rail-count" aria-live="polite"></span></summary>
        <div class="rail-actions">
          <button type="button" class="quiet-btn" id="pick-newest">Newest</button>
          <button type="button" class="quiet-btn" id="pick-all">All</button>
          <button type="button" class="quiet-btn" id="pick-none">None</button>
        </div>
        <div class="rail-list">
          {models.map((m) => (
            <div class="rail-model" role="group" aria-label={m.name}>
              <label class="model-box">
                <input type="checkbox" data-model-box={m.id} />
                <i style={`background: var(--m-${m.model})`}></i><strong>{m.name}</strong>
                <span class="note">{FAMILY[m.family]}</span>
              </label>
              <ul>
                {rows.filter((r) => r.model === m.id).map((r) => (
                  <li>
                    <label>
                      <input type="checkbox" data-row-box={r.key} data-of={m.id} />
                      <span>{r.short}</span><span class="note n">{`n = ${r.rollouts}`}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="note rail-foot">
          {`${total} scored rollouts in all. `}<a href={url('experiments/')}>What each model is</a>.
        </p>
      </details>
    </aside>

    <div class="main" id="results-main">
      <section class="block" aria-labelledby="h-score">
        <h2 id="h-score">Score</h2>
        <p class="lede">
          {`Balanced accuracy over the 12 rack slots, the bin left out. A run passes with at least ${MIN_PER_SLOT} rollouts at every ` +
            `slot and a total of at least ${PASS_MARK * 100}%. `}<a href={url('experiments/#score')}>How it is calculated</a>.
        </p>
        <ScoreTable rows={rows} follow />
        <p class="note empty" id="score-empty" hidden>Nothing ticked. Pick at least one row on the left.</p>
      </section>

      <section class="block" aria-labelledby="h-far">
        <div class="block-head">
          <h2 id="h-far">How far each one got</h2>
          <div class="seg-ctl" role="group" aria-label="Bar scale">
            <button type="button" class="quiet-btn" aria-pressed="true" data-scale="count">Number of rollouts</button>
            <button type="button" class="quiet-btn" aria-pressed="false" data-scale="share">Share of its rollouts</button>
          </div>
        </div>
        <StageLegend inline />
        <div class="bars" id="bars" data-mode="count" style="--max: 1">
          <div class="axis" id="axis" aria-hidden="true"></div>
          {rows.map((r) => (
            <div class="bar-row" data-row={r.key}>
              <div class="bar-label"><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span></div>
              <div class="bar" role="img"
                aria-label={`${r.label}: ${stages.map((s) => `${count(r, s.key)} ${s.label.toLowerCase()}`).join(', ')}`}>
                {stages.map((s, i) => count(r, s.key) > 0 && (
                  <span class="seg" style={`--count: ${count(r, s.key)}; --share: ${(count(r, s.key) / r.rollouts) * 100}; background: var(--st-${i + 1}); color: var(--stt-${i + 1})`}
                    title={`${r.label}\n${s.label}: ${count(r, s.key)} of ${r.rollouts} rollouts`}>{count(r, s.key)}</span>
                ))}
              </div>
              <div class="bar-n num">{`n = ${r.rollouts}`}</div>
            </div>
          ))}
        </div>
        <p class="note empty" id="bars-empty" hidden>Nothing ticked. Pick at least one row on the left.</p>
        <details class="twin">
          <summary>Show the numbers as a table</summary>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>Model and checkpoint</th><th class="r">Rollouts</th>{stages.map((s) => <th class="r">{s.label}</th>)}<th class="r">Of them, on untrained moves</th><th>Scored from</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr data-row={r.key}><td>{r.label}</td><td class="r num">{r.rollouts}</td>{stages.map((s) => <td class="r num">{count(r, s.key)}</td>)}<td class="r num">{r.untrained?.rollouts ?? 0}</td><td>{r.scored_by === 'notes' ? 'the operator’s notes' : 'the arm'}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
        <p class="note after">{`Each rollout counts once, in the furthest outcome it reached. `}<a href={url('experiments/#scored')}>How a rollout is scored</a>.</p>
      </section>

      <section class="block" aria-labelledby="h-slot">
        <h2 id="h-slot">Where the vials ended</h2>
        <p class="lede">
          {`For each ticked row, four at most: where its rollouts started and ended, slot by slot, beside the demonstrations it trained ` +
            `on, and for rows scored from the operator's notes, where every vial ended. `}<a href={url('experiments/#read')}>How to read them</a>.
        </p>
        <ul class="legend slot-key">
          <li><i class="k-got"></i>Rollouts: got through / tried at that slot</li>
          <li><i class="k-demo"></i>Demonstrations in its training set</li>
          <li><i class="k-none"></i>None there</li>
          <li><i class="k-untr"></i>Held-out slot</li>
          <li class="heat"><span>{HEAT.concat(1).map((_, i) => <i style={`background: var(--ob-${i + 1})`}></i>)}</span>Table: share of the row, light to dark</li>
        </ul>
        {rows.map((r) => {
          const c = r.confusion as Conf | null;
          return (
            <div class="slot-row" data-row={r.key}>
              <h3><i style={`background: var(--m-${r.family})`}></i>{r.label}{' '}<span class="sub">{`${r.rollouts} rollouts` +
                (r.train_set ? `, trained on ${r.train_set} (${demoSets[r.train_set].episodes} demonstrations)` : '')}</span></h3>
              <SlotMaps maps={mapsOf(r)} />
              {r.untrained && (
                <p class="note split">{`${r.rollouts - r.untrained.rollouts} of the ${r.rollouts} rollouts were on moves it was trained on, ` +
                  `${r.untrained.rollouts} on moves it was never trained on (${untrMoves(r.untrained.moves)}).`}</p>
              )}
              {c && (
                <div class="cm-wrap">
                  <p class="cm-title">Where every vial ended, by the slot asked for</p>
                  <div class="table-scroll">
                    <table class="cm">
                      <caption class="visually-hidden">{`Where each vial of ${r.label} ended, by the slot asked for`}</caption>
                      <thead>
                        <tr>
                          <th scope="col" class="corner">Asked ↓ · ended →</th>
                          {cmCols.map((col) => <th scope="col" class:list={['ch', { extra: col.extra }]} title={col.title}>{col.label}</th>)}
                          <th scope="col" class="r">Recall</th>
                        </tr>
                      </thead>
                      <tbody>
                        {CM_SLOTS.map((s) => {
                          const row = c[s] ?? {}, n = sumOf(row);
                          return (
                            <tr class:list={{ none: !n }}>
                              <th scope="row">{s}</th>
                              {cmCols.map((col) => {
                                const v = row[col.k] ?? 0, k = v ? byBounds(v / n, HEAT) : 0;
                                return (
                                  <td class:list={['cell', { diag: col.k === s, on: v > 0 }]}
                                    style={v ? `--bg: var(--ob-${k}); --fg: var(--obt-${k})` : undefined}
                                    title={v ? `Asked for ${s}, ${endedAt(col.k, s)}: ${v} of ${n}` : undefined}>{v || ''}</td>
                                );
                              })}
                              <td class="r rec">{n ? `${row[s] ?? 0}/${n} = ${pctOf((row[s] ?? 0) / n)}` : '–'}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                      <tfoot>
                        <tr>
                          <th scope="row">Precision</th>
                          {cmCols.map((col) => {
                            const tot = col.extra ? 0 : colTotal(c, col.k);
                            return <td class="prec">{tot ? `${c[col.k]?.[col.k] ?? 0}/${tot}` : ''}</td>;
                          })}
                          <td></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              )}
            </div>
          );
        })}
        <p class="note empty" id="slots-empty" hidden>Nothing ticked.</p>
        <p class="note after" id="slots-more" hidden>More than four rows are ticked: the first four are shown.</p>
      </section>

      <section class="block" aria-labelledby="h-watch">
        <h2 id="h-watch">Rollouts to watch</h2>
        <p class="lede">Rollouts of the ticked rows, every camera the model saw at once. They loop; click one to pause it. Filter by how far they got:</p>
        <div class="seg-ctl stage-filter" role="group" aria-label="Show rollouts that reached">
          {stages.map((s, i) => (
            <button type="button" class="quiet-btn" aria-pressed="true" data-stage={s.key}><i style={`background: var(--st-${i + 1})`}></i>{s.label}</button>
          ))}
        </div>
        <div class="clips">
          {clips.map((f) => (
            <div class="clip-wrap" data-row={f.row} data-stage={f.stage}>
              <Clip src={f.src} poster={f.poster} w={f.w} h={f.h} caption={f.caption} move={f.move}
                vialAt={f.at ?? undefined} missAt={f.miss ?? undefined} vial={(f.vial ?? 'neutral') as 'red'} used={f.used} outcome={f.stage} kind={f.kind} />
            </div>
          ))}
        </div>
        <p class="note empty" id="clips-empty" hidden>No rollout of the ticked rows matches. Only some rollouts were picked to be shown.</p>
      </section>

      <section class="block" aria-labelledby="h-moves">
        <h2 id="h-moves">Move by move</h2>
        <p class="lede">
          {`Every move each ticked row was asked, four rows at most, with the number of demonstrations of that exact move in its ` +
            `training set. Rows scored from the operator's notes list every note as written.`}
        </p>
        {rows.map((r) => {
          const e = expRow.get(r.key);
          return e && (
            <div class="mv-row" data-row={r.key}>
              <h3><i style={`background: var(--m-${r.family})`}></i>{r.label}{' '}<span class="sub">{`${r.rollouts} rollouts`}</span></h3>
              {storyOf(r).map((n) => <p class="story"><strong>{`${n.title}.`}</strong>{` ${n.text}`}</p>)}
              <MoveTable r={e} />
            </div>
          );
        })}
        <p class="note empty" id="mv-empty" hidden>Nothing ticked.</p>
        <p class="note after" id="mv-more" hidden>More than four rows are ticked: the first four are shown.</p>
      </section>
    </div>
  </div>
</Base>

<script>
  import '../charts/october';
</script>

<style>
  .head { padding-bottom: 1.5rem; }
  .work { display: grid; grid-template-columns: 19rem minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; padding-bottom: 4rem; }
  .rail { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow: auto; border: 1px solid var(--rule); border-radius: 6px; background: var(--raise); }
  .rail-box { padding: 0.9rem 1rem 1rem; }
  .rail-box summary { display: flex; align-items: baseline; justify-content: space-between; cursor: pointer; list-style: none; }
  .rail-box summary::-webkit-details-marker { display: none; }
  .rail-box h2 { font-size: var(--step-1); }
  .count { font-size: var(--step--1); color: var(--ink-2); }
  .rail-actions { display: flex; gap: 0.4rem; margin: 0.8rem 0; }
  .rail-list { display: grid; gap: 1rem; }
  .model-box { display: flex; align-items: center; gap: 0.45rem; cursor: pointer; flex-wrap: wrap; }
  .model-box i { width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .rail ul { list-style: none; margin: 0.35rem 0 0 1.55rem; padding: 0; display: grid; gap: 0.2rem; }
  .rail li label { display: flex; align-items: baseline; gap: 0.5rem; cursor: pointer; }
  .rail li .n { margin-left: auto; font-variant-numeric: tabular-nums; }
  .rail input { accent-color: var(--ink); }
  .rail-foot { margin-top: 1rem; }
  .main { display: grid; gap: 3.5rem; min-width: 0; }
  .block { min-width: 0; }
  .block + .block { padding-top: 2.5rem; border-top: 1px solid var(--rule); }
  .block h2 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem 2rem; margin-bottom: 0.6rem; }  /* the scale buttons beside the heading, not at the far right */
  .block-head h2 { margin: 0; }
  .seg-ctl { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .seg-ctl .quiet-btn { display: inline-flex; align-items: center; gap: 0.4rem; }
  .seg-ctl i { width: 0.7rem; height: 0.7rem; border-radius: 3px; }
  .stage-filter { margin: 0.8rem 0 1.4rem; }
  .stage-filter .quiet-btn[aria-pressed='false'] { opacity: 0.55; }

  .bars { display: grid; gap: 0.5rem; margin-top: 0.4rem; }
  .axis { display: grid; grid-template-columns: minmax(9rem, 19rem) minmax(0, 1fr) 4.8rem; column-gap: 0.8rem; font-size: 1.05rem; color: var(--steel); }
  .axis :global(.ticks) { position: relative; height: 1.1rem; grid-column: 2; }
  .axis :global(.ticks span) { position: absolute; transform: translateX(-50%); }
  .axis :global(.ticks span:first-child) { transform: none; }
  .axis :global(.ticks span:last-child) { transform: translateX(-100%); }
  .bar-row { display: grid; grid-template-columns: minmax(9rem, 19rem) minmax(0, 1fr) 4.8rem; align-items: center; gap: 0 0.8rem; }
  .bar-row[hidden] { display: none; }
  .bar-label { display: flex; align-items: center; gap: 0.5rem; font-size: var(--step-0); line-height: 1.3; }
  .bar-label i { width: 0.65rem; height: 0.65rem; border-radius: 50%; flex: none; }
  .bar { display: flex; height: 2.8rem; gap: 2px; }
  .seg { display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 650; font-variant-numeric: tabular-nums;
         overflow: hidden; min-width: 0; width: calc(var(--share) * 1%); }
  .bars[data-mode='count'] .seg { width: calc(var(--count) / var(--max) * 100%); }
  .seg:first-child { border-radius: 4px 0 0 4px; }
  .seg:last-child { border-radius: 0 4px 4px 0; }
  .seg:only-child { border-radius: 4px; }
  .bar-n { font-size: var(--step-0); color: var(--ink-2); text-align: right; white-space: nowrap; }
  .split { margin-top: 0.8rem; font-size: var(--step-0); }
  .twin { margin-top: 1rem; font-size: var(--step--1); color: var(--ink-2); }
  .twin summary { cursor: pointer; width: fit-content; }
  .twin tr[hidden] { display: none; }
  .after { margin-top: 1rem; }
  .empty { margin-top: 1rem; }

  .slot-key { margin-top: 1.1rem; font-size: var(--step-0); color: var(--ink); gap: 0.5rem 1.6rem; }
  .slot-key i { width: 1rem; height: 1rem; border-radius: 50%; box-sizing: border-box; }
  .slot-key .k-got { background: var(--slot-got); }
  .slot-key .k-demo { background: var(--slot-demo); }
  .slot-key .k-none { background: var(--page); border: 1.5px solid var(--rack); }
  .slot-key .k-untr { background: var(--page); border: 1.5px solid var(--rack); outline: 2px dashed var(--ink-2); outline-offset: 2px; }


  table.cm { border-collapse: separate; border-spacing: 2px; font-variant-numeric: tabular-nums; font-size: var(--step--1); margin-top: 0.4rem; }
  table.cm th, table.cm td { padding: 0.32rem 0.3rem; text-align: center; min-width: 2.15rem; }
  table.cm thead th { color: var(--ink-2); font-weight: 600; vertical-align: bottom; }
  table.cm thead th.extra { max-width: 4.8rem; white-space: normal; line-height: 1.2; }
  table.cm .corner { text-align: left; white-space: nowrap; padding-right: 0.7rem; font-weight: 500; }
  table.cm tbody th, table.cm tfoot th { text-align: left; font-weight: 600; padding-right: 0.7rem; white-space: nowrap; }
  table.cm td.cell { background: var(--bg, var(--raise)); color: var(--fg, var(--ink)); border-radius: 3px; font-weight: 650; }
  table.cm td.cell.on:hover { filter: brightness(1.12); }
  table.cm td.diag { box-shadow: inset 0 0 0 2px var(--ink); }
  table.cm td.rec { text-align: right; white-space: nowrap; padding-left: 0.8rem; color: var(--ink); }
  table.cm tr.none th, table.cm tr.none td.rec { color: var(--steel); font-weight: 500; }
  table.cm tfoot th, table.cm tfoot td { color: var(--ink-2); padding-top: 0.5rem; white-space: nowrap; }
  .slot-row { margin-top: 2.4rem; }
  .slot-row[hidden] { display: none; }
  .slot-row h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.7rem; font-size: var(--step-1); margin-bottom: 0.4rem; }
  .slot-row h3 i { width: 0.75rem; height: 0.75rem; border-radius: 50%; align-self: center; }
  .slot-row h3 .sub { font-size: var(--step-0); font-weight: 400; color: var(--ink-2); }
  .lede { max-width: var(--measure); }
  .slot-key .heat span { display: inline-flex; gap: 2px; }
  .slot-key .heat i { width: 0.8rem; height: 1rem; border-radius: 2px; }
  .cm-wrap { margin-top: 1.4rem; }
  .cm-title { font-weight: 600; margin-bottom: 0.2rem; }
  .mv-row { margin-top: 2.2rem; }
