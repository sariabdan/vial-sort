---
import Base from '../layouts/Base.astro';
import SlotVials from '../components/SlotVials.astro';
import Clip from '../components/Clip.astro';
import MoveTable from '../components/MoveTable.astro';
import results from '../data/results.json';
import registry from '../data/registry.json';
import experiments from '../data/experiments.json';
import media from '../data/media.json';
import { moveLabel, url, demoSet, sentences } from '../lib/site';
import { byBounds } from '../lib/rackmaps';
import { pctOf, scoreRun, weakSlots, verdictText, MIN_PER_SLOT, PASS_MARK } from '../lib/score';

// Results shows results only. What a word means, how a rollout or a run is scored, and what the numbers cannot say are
// explained once, on Testing (method.astro), and linked from here.
// The page is one screen. On the left, every run in a short list that is also the picker: one line per model (its
// newest run), its other checkpoints folded under it. On the right, the ticked runs as rows, in the order they were
// ticked, one tab at a time: score, slots and video; what happened; every move. In the first tab every row has the
// same two columns of vials, so the slots line up down the page and any number of runs can be compared.
// src/charts/october.ts shows, orders and letters the rows and switches the tabs; every run's row is in the page.
const rows = results.rows;
// newest first, then the bigger run
const board = [...rows].sort((a, b) => (b.days.at(-1) ?? '').localeCompare(a.days.at(-1) ?? '') || b.rollouts - a.rollouts);
// one group per model, newest model first; inside a group its newest run leads and the rest fold under it
const groups = [...new Set(board.map((r) => r.model))].map((id) => ({
  id, rows: board.filter((r) => r.model === id),  // board order: the newest run of the model leads, the bigger one on a tie
}));
// "16k · sync" → "16k": the list has room for the checkpoint; the mode is named only when it is not the usual one
const ckOf = (short: string) => short.replace(' · sync', '').replace(' · ', ' ');
const maxN = Math.max(...rows.map((r) => r.rollouts));  // the list's bars are as long as the run has rollouts
const dayOf = (d?: string) => (d && /^\d{8}$/.test(d)
  ? new Date(`${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6)}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) : '–');
// sets worth comparing, offered as buttons: the newest run of each kind of model, and π0.5 from the first data set to the second
const biggestRun = (run: string) => {
  const id = registry.models.find((m) => m.run === run)?.id;
  return rows.filter((r) => r.model === id).sort((a, b) => b.rollouts - a.rollouts)[0]?.key;
};
const presets = [
  { label: 'Newest of each kind', keys: results.defaults },
  { label: 'π0.5: 100 → 220 demonstrations', keys: ['pi05-canon', 'pi05-b16k', 'pi05-a16k'].map(biggestRun).filter((k): k is string => !!k) },
].filter((p) => p.keys.length > 1);
const models = registry.models.filter((m) => rows.some((r) => r.model === m.id));
const stages = results.stages;
const demoSets = results.demo_sets as Record<string, { episodes: number; per_source: Record<string, number>; per_destination: Record<string, number> }>;
const FAMILY = { pi05: 'π0.5', flux3: 'FLUX 3 Action', isaac: 'Isaac 0.5' } as Record<string, string>;
// up to 8 untrained moves are named; more than that are counted, and listed under Move by move
const untrMoves = (m: Record<string, number>) => {
  const k = Object.keys(m);
  return k.length <= 8 ? k.map(moveLabel).join(', ') : `${k.length} different moves, each listed under Move by move`;
};
const clips = media.featured as (typeof media.featured)[number][];
const total = results.total;
const count = (r: (typeof rows)[number], key: string) => r.stages[key as keyof typeof r.stages];

// where every vial ended, for rows scored from the operator's notes (a confusion matrix)
type Conf = Record<string, Record<string, number>>;
const CM_SLOTS = [...['L1', 'L2', 'L3', 'L4', 'L5', 'L6'], 'bin', ...['R1', 'R2', 'R3', 'R4', 'R5', 'R6']];
const cmCols = [
  ...CM_SLOTS.map((s) => ({ k: s, label: s, extra: false, title: `Ended at ${s === 'bin' ? 'the bin' : s}` })),
  { k: 'beside', label: 'Dropped beside', extra: true, title: 'Dropped in front of or behind the asked slot' },
  { k: 'held', label: 'Never let go', extra: true, title: 'Carried the vial and never let go' },
  { k: 'none', label: 'Not picked up', extra: true, title: 'Never picked up the asked vial (or took another one)' },
];
const HEAT = [0.2, 0.4, 0.6, 0.8];  // share of the row: five steps of the blue ramp
const sumOf = (o: Record<string, number> = {}) => Object.values(o).reduce((a, b) => a + b, 0);
const colTotal = (c: Conf, k: string) => Object.values(c).reduce((a, r) => a + (r[k] ?? 0), 0);
const endedAt = (k: string, s: string) =>
  k === s ? 'ended in it' : k === 'beside' ? 'dropped beside it' : k === 'held' ? 'never let go'
    : k === 'none' ? 'never picked up the right vial' : `ended at ${k === 'bin' ? 'the bin' : k}`;

// Move by move: each row's moves (experiments.json), with its model's "On the robot" note above its biggest row
const expRow = new Map(experiments.rows.map((r) => [r.key, r]));
const biggestOf = new Map<string, (typeof rows)[number]>();
for (const r of rows) {
  const b = biggestOf.get(r.model);
  if (!b || r.rollouts > b.rollouts) biggestOf.set(r.model, r);
}
const storyOf = (r: (typeof rows)[number]) => biggestOf.get(r.model)?.key === r.key
  ? (experiments.models.find((m) => m.id === r.model)?.notes ?? []).filter((n) => /^On the robot/i.test(n.title)) : [];
---
<Base
  page="results"
  title="Results"
  description="Every model on the robot on one screen: all runs in a list, and up to four of them side by side with their score, where their vials ended, their rollouts on video and every move they were asked."
>
  <div class="wrap dash" data-no-onpage>
    <header class="dash-head">
      <h1>Results</h1>
      <p class="note">
        {`${rows.length} runs, ${total} scored rollouts. Tick the runs to compare. Development test runs: `}
        <a href={url('method/#caveats')}>what the numbers cannot say</a>{' · '}<a href={url('method/#score')}>how the score is built</a>
      </p>
    </header>

    <aside class="runs" aria-label="Runs to compare">
      <details class="runs-box" open>
        <summary><strong>Runs</strong><span class="note" id="runs-count" aria-live="polite"></span></summary>
        <p class="presets">
          {presets.map((p) => <button type="button" class="quiet-btn" data-preset={p.keys.join(',')}>{p.label}</button>)}
          <button type="button" class="quiet-btn" data-preset="">Clear</button>
        </p>
        <p class="note" id="pick-note" role="status"></p>
        <p class="list-head" aria-hidden="true"><span>Run, newest first</span><span>Rollouts</span><span>Score</span></p>
        <div class="run-list">
          {groups.map((g) => {
            // one line of the tree: a run. As a child of its model it shows only its checkpoint and mode.
            const line = (r: (typeof rows)[number], child = false) => (
              <label class:list={['run', child && 'child']} data-run={r.key} title={`${r.label}: ${r.rollouts} rollouts, last on the robot ${dayOf(r.days.at(-1))}`}>
                <input type="checkbox" data-row-box={r.key} data-of={r.model} />
                <b class="letter"></b>
                {!child && <i class="dot" style={`background: var(--m-${r.family})`}></i>}
                <span class="nm">{child ? r.short : <>{r.name}<span class="ck">{ckOf(r.short)}</span></>}</span>
                <span class="mini-track" aria-hidden="true">
                  <span class="mini" style={`width: max(0.5rem, ${(r.rollouts / maxN) * 100}%)`}>
                    {stages.map((st, i) => count(r, st.key) > 0 && <i style={`flex: ${count(r, st.key)}; background: var(--st-${i + 1})`}></i>)}
                  </span>
                </span>
                <span class="n num">{r.rollouts}</span>
                <span class="sc num">{pctOf(scoreRun(r.by_destination).total)}</span>
              </label>
            );
            // a model with one run is a leaf; a model with several is a branch: its box ticks all of them, and its
            // checkpoints are listed under it (open from the start; the twist closes a branch)
            if (g.rows.length === 1) return line(g.rows[0]);
            const lead = g.rows[0];
            return (
              <details class="node" open>
                <summary class="run parent" title={`${lead.name}: ${g.rows.length} checkpoints. Its box ticks all of them; click the name to open the list.`}>
                  <input type="checkbox" data-model-box={g.id} aria-label={`All ${g.rows.length} checkpoints of ${lead.name}`} />
                  <i class="twist" aria-hidden="true"></i>
                  <span class="nm"><i class="dot" style={`background: var(--m-${lead.family})`}></i>{lead.name}<span class="ck">{`${g.rows.length} runs`}</span></span>
                  <span></span>
                  <span class="n num">{g.rows.reduce((a, r) => a + r.rollouts, 0)}</span>
                  <span class="sc num"></span>
                </summary>
                {g.rows.map((r) => line(r, true))}
              </details>
            );
          })}
        </div>
        <ul class="legend key">
          {stages.map((s, i) => <li><i style={`background: var(--st-${i + 1})`}></i>{s.label}</li>)}
          <li>Bar length: number of rollouts</li>
        </ul>
      </details>
    </aside>

    <div class="view" data-await>
      <div class="tabs" role="tablist" aria-label="What to compare">
        <button type="button" role="tab" data-tab="compare" aria-selected="true">Score, slots and video</button>
        <button type="button" role="tab" data-tab="ended" aria-selected="false">Where vials ended</button>
        <button type="button" role="tab" data-tab="notes" aria-selected="false">What happened</button>
        <button type="button" role="tab" data-tab="detail" aria-selected="false">Every move</button>
      </div>
      <p class="note empty" id="none-picked" hidden>Nothing is ticked. Tick a run in the list, or pick one of the sets above it.</p>

      <section class="panel" data-panel="compare" id="h-score">
        <h2 class="visually-hidden">Score and slots</h2>
        <ul class="legend map-key" aria-label="How to read the vials">
          <li class="key-lead">A vial fills to the share of rollouts that got through:</li>
          <li><i class="kv k3"><i></i></i>all</li>
          <li><i class="kv k2"><i></i></i>half or more</li>
          <li><i class="kv k1"><i></i></i>under half</li>
          <li><i class="kv k0"><i></i></i>none</li>
          <li><i class="kv kn"><i></i></i>not tried</li>
          <li><i class="kv kh"><i></i></i>never demonstrated that way (held out)</li>
          <li>Under each: got through / tried. Slots 1 to 6, left to right.</li>
          <li><i class="kv kdm"><i></i></i>the demonstrations it trained on, under each run</li>
          <li><label class="demo-switch"><input type="checkbox" id="show-demos" checked />Show demonstrations</label></li>
        </ul>
        <div class="runs-table">
          <div class="rt-row rt-head" aria-hidden="true">
            <span class="rt-who"></span>
            <div class="rt-cap">
              <p><b>Picked up from</b><span>the slot the vial started in</span></p>
              <div class="caps"><span class="c6">left rack</span><span class="c6">right rack</span></div>
            </div>
            <div class="rt-cap">
              <p><b>Placed into</b><span>the slot the command asked for</span></p>
              <div class="caps"><span class="c6">left rack</span><span class="cb">bin</span><span class="c6">right rack</span></div>
            </div>
          </div>
          {rows.map((r) => {
            const s = scoreRun(r.by_destination), weak = weakSlots(r.by_destination);
            const about = `${r.label}. ${verdictText(s)}. Weak slots: ${weak.length ? weak.join(', ') : 'none'}. Scored from ${r.scored_by === 'notes' ? 'the operator’s notes' : 'the arm'}.` +
              (r.train_set ? ` Trained on ${r.train_set}.` : '');
            return (
              <div class="rt-row col" data-row={r.key} data-init-off={!results.defaults.includes(r.key) || undefined}>
                <div class="rt-who" title={about}>
                  <p class="col-head">
                    <button type="button" class="grip" aria-label={`Move ${r.label}: drag it, or press the up or down arrow key`} title="Drag to reorder">
                      <svg viewBox="0 0 8 14" aria-hidden="true"><circle cx="2" cy="2" r="1.3" /><circle cx="6" cy="2" r="1.3" /><circle cx="2" cy="7" r="1.3" /><circle cx="6" cy="7" r="1.3" /><circle cx="2" cy="12" r="1.3" /><circle cx="6" cy="12" r="1.3" /></svg>
                    </button>
                    <b class="letter"></b><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span></p>
                  <p class="who-score"><b class="num">{pctOf(s.total)}</b><span>{`${r.rollouts} rollouts`}</span></p>
                  <p class="who-parts">{`Trained slots `}<b class="num">{pctOf(s.trained)}</b>{` · held-out `}<b class="num">{pctOf(s.held)}</b></p>
                  <span class="mini thin" role="img" aria-label={stages.map((st) => `${count(r, st.key)} ${st.label.toLowerCase()}`).join(', ')}
                    title={stages.map((st) => `${st.label}: ${count(r, st.key)}`).join('\n')}>
                    {stages.map((st, i) => count(r, st.key) > 0 && <i style={`flex: ${count(r, st.key)}; background: var(--st-${i + 1})`}></i>)}
                  </span>
                </div>
                <SlotVials bySource={r.by_source} byDestination={r.by_destination} demos={r.train_set ? demoSets[r.train_set] : null} label={r.label} />
                {r.train_set && (
                  <>
                    <p class="who-demo" title={`Trained on ${r.train_set}`}><i></i><b class="num">{demoSets[r.train_set].episodes}</b>{` demonstrations it trained on`}</p>
                    <SlotVials demoOnly demos={demoSets[r.train_set]} label={`${r.label}: its ${demoSets[r.train_set].episodes} training demonstrations`} />
                  </>
                )}
              </div>
            );
          })}
        </div>
        <p class="note foot">
          Hover a vial for its slot and its demonstrations, and a run's name for its verdict and weak slots.
          {' '}<a href={url('method/#read')}>How to read the vials</a>{' · '}<a href={url('method/#scored')}>How a rollout is scored</a>
        </p>

        <div class="vids-head" id="h-watch">
          <h3>One rollout of each</h3>
          <div class="seg-ctl" role="group" aria-label="Show the rollout that">
            {stages.slice().reverse().map((s) => (
              <button type="button" class="quiet-btn" aria-pressed={s.key === 'released' ? 'true' : 'false'} data-stage={s.key}>
                <i style={`background: var(--st-${stages.indexOf(s) + 1})`}></i>{s.label}
              </button>
            ))}
          </div>
        </div>
        <div class="cols wide vids">
          {rows.map((r) => (
            <div class="col" data-row={r.key} data-init-off={!results.defaults.includes(r.key) || undefined}>
              <p class="col-head"><b class="letter"></b><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span></p>
              {clips.filter((f) => f.row === r.key).map((f) => (
                <div class="clip-wrap" data-stage={f.stage} data-init-off={f.stage !== 'released' || undefined}>
                  <Clip src={f.src} poster={f.poster} w={f.w} h={f.h} caption={f.caption} move={f.move}
                    vialAt={f.at ?? undefined} missAt={f.miss ?? undefined} vial={(f.vial ?? 'neutral') as 'red'} used={f.used} outcome={f.stage} kind={f.kind} />
                </div>
              ))}
              <p class="note no-clip" hidden>No rollout of this kind was picked to be shown for this run.</p>
            </div>
          ))}
        </div>
      </section>

      <section class="panel" data-panel="notes" id="h-said" hidden>
        <h2 class="visually-hidden">What happened on the robot</h2>
        <div class="cols stacked">
          {rows.map((r) => (
            <div class="col" data-row={r.key} data-init-off={!results.defaults.includes(r.key) || undefined}>
              <p class="col-head"><b class="letter"></b><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span></p>
              {storyOf(r).length > 0
                ? storyOf(r).map((n) => <div class="acct"><p class="acct-title">{n.title}</p><ul class="said">{sentences(n.text).map((s) => <li>{s}</li>)}</ul></div>)
                : <p class="note">No written account for this run.</p>}
            </div>
          ))}
        </div>
      </section>

      <section class="panel" data-panel="detail" id="h-moves" hidden>
        <h2 class="visually-hidden">Every move</h2>
        <p class="note cm-key">One line per ticked run, its moves side by side in the order they were run: scroll a line to the right for more. The bar on a card is how far the move got; a dashed card is a move it never trained on.</p>
        <div class="stack">
          {rows.map((r) => {
            const e = expRow.get(r.key);
            return (
              <div class="wide-row" data-row={r.key} data-init-off={!results.defaults.includes(r.key) || undefined}>
                <p class="col-head"><b class="letter"></b><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span><span class="note">{`${r.rollouts} rollouts`}</span></p>
                {e ? <MoveTable r={e} /> : <p class="note">No move list for this run.</p>}
              </div>
            );
          })}
        </div>
      </section>

      <section class="panel" data-panel="ended" id="h-ended" hidden>
        <h2 class="visually-hidden">Where every vial ended</h2>
        <p class="note cm-key">
          A row is the slot the command asked for; a column is where the vial ended. The outlined cell is the asked slot, and the
          shade is the share of the row, light to dark. Runs scored from the arm have no table: the arm cannot see where the vial ended.
        </p>
        <div class="stack">
          {rows.map((r) => {
            const c = r.confusion as Conf | null;
            return (
              <div class="wide-row" data-row={r.key} data-init-off={!results.defaults.includes(r.key) || undefined}>
                <p class="col-head"><b class="letter"></b><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span><span class="note">{`${r.rollouts} rollouts`}</span></p>
                {c ? (
                    <div class="table-scroll">
                      <table class="cm">
                        <caption class="visually-hidden">{`Where each vial of ${r.label} ended, by the slot asked for`}</caption>
                        <thead>
                          <tr>
                            <th scope="col" class="corner">Asked ↓ · ended →</th>
                            {cmCols.map((col) => <th scope="col" class:list={['ch', { extra: col.extra }]} title={col.title}>{col.label}</th>)}
                            <th scope="col" class="r">Recall</th>
                          </tr>
                        </thead>
                        <tbody>
                          {CM_SLOTS.map((s) => {
                            const row = c[s] ?? {}, n = sumOf(row);
                            return (
                              <tr class:list={{ none: !n }}>
                                <th scope="row">{s}</th>
                                {cmCols.map((col) => {
                                  const v = row[col.k] ?? 0, k = v ? byBounds(v / n, HEAT) : 0;
                                  return (
                                    <td class:list={['cell', { diag: col.k === s, on: v > 0 }]}
                                      style={v ? `--bg: var(--ob-${k}); --fg: var(--obt-${k})` : undefined}
                                      title={v ? `Asked for ${s}, ${endedAt(col.k, s)}: ${v} of ${n}` : undefined}>{v || ''}</td>
                                  );
                                })}
                                <td class="r rec">{n ? `${row[s] ?? 0}/${n} = ${pctOf((row[s] ?? 0) / n)}` : '–'}</td>
                              </tr>
                            );
                          })}
                        </tbody>
                        <tfoot>
                          <tr>
                            <th scope="row">Precision</th>
                            {cmCols.map((col) => {
                              const tot = col.extra ? 0 : colTotal(c, col.k);
                              return <td class="prec">{tot ? `${c[col.k]?.[col.k] ?? 0}/${tot}` : ''}</td>;
                            })}
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                ) : <p class="note">Scored from the arm, which cannot see where the vial ended.</p>}
              </div>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import '../charts/october';
</script>

<style>
  /* The whole page is one screen: the runs on the left, one tab of the comparison on the right. Smaller type than the
     reading pages, because this is a panel to scan, not text to read. */
  .dash { --gutter: 1rem; display: grid; grid-template-columns: 19.5rem minmax(0, 1fr); gap: 0.4rem 1.2rem; align-items: start;
          padding-block: 0.9rem 2rem; font-size: 0.95rem; line-height: 1.4; }
  .dash .note { font-size: 0.85rem; line-height: 1.4; }
  .dash-head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
  .dash-head h1 { font-size: var(--step-1); }
  .dash-head p { max-width: none; }

  /* the runs: the list is the leaderboard and the picker */
  .runs { position: sticky; top: 0.5rem; max-height: calc(100vh - 8.2rem); overflow-y: auto; overflow-x: hidden; min-width: 0;
          /* a slim scrollbar in its own gutter, clear of the scores, that only shows its thumb */
          scrollbar-gutter: stable; scrollbar-width: thin; scrollbar-color: var(--rack) transparent; padding-right: 0.6rem; }
  .runs::-webkit-scrollbar { width: 8px; }
  .runs::-webkit-scrollbar-track { background: transparent; }
  .runs::-webkit-scrollbar-thumb { background: var(--rack); border-radius: 4px; }
  .runs::-webkit-scrollbar-thumb:hover { background: var(--steel); }
  .runs-box > summary { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; list-style: none; padding-block: 0.3rem; }
  .runs-box > summary::-webkit-details-marker { display: none; }
  .presets { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.2rem 0 0.4rem; }
  .presets .quiet-btn { font-size: 0.8rem; padding: 0.05rem 0.55rem; }
  #pick-note:empty { display: none; }
  #pick-note { color: var(--critical-text); margin-bottom: 0.3rem; }
  /* one line per run: tick, letter or model dot, name and checkpoint, a bar as long as its rollouts, their number, the score */
  .list-head, .run { display: grid; grid-template-columns: 1.1rem 1.25rem minmax(0, 1fr) 2.8rem 1.4rem 2.4rem; column-gap: 0.35rem; align-items: center; }
  .list-head { font-size: 0.75rem; color: var(--steel); padding: 0.2rem 0.3rem; border-bottom: 1px solid var(--rule); max-width: none; }
  .list-head span:first-child { grid-column: 1 / 4; }
  .list-head span:nth-child(2) { grid-column: 4 / 6; }
  .list-head span:last-child { text-align: right; }
  .run { padding: 0.24rem 0.3rem; border-radius: 4px; cursor: pointer; border-bottom: 1px solid var(--grid); }
  .run:hover { background: var(--raise); }
  .run:has(input:checked) { background: var(--raise); box-shadow: inset 3px 0 0 var(--ink); }
  .run input { accent-color: var(--ink); margin: 0; cursor: pointer; }
  .run .letter, .run .dot { grid-column: 2; grid-row: 1; justify-self: center; }
