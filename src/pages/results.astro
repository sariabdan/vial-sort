---
import Base from '../layouts/Base.astro';
import SlotMaps from '../components/SlotMaps.astro';
import ScoreTable from '../components/ScoreTable.astro';
import StageLegend from '../components/StageLegend.astro';
import Clip from '../components/Clip.astro';
import Term from '../components/Term.astro';
import TeX from '../components/TeX.astro';
import ScoreFormula from '../components/ScoreFormula.astro';
import results from '../data/results.json';
import registry from '../data/registry.json';
import media from '../data/media.json';
import { moveLabel, url } from '../lib/site';
import { slotDemos, slotGot, untrainedSlots, byBounds, type SlotMap } from '../lib/rackmaps';
import { scoreRun, pctOf, workedPart, workedTex, totalTex, medianShare, pooled, MIN_PER_SLOT, PASS_MARK, WEAK_AT,
  RACK_SLOTS, TRAINED_SLOTS, HELD_OUT_SLOTS } from '../lib/score';

const rows = results.rows;
const models = registry.models.filter((m) => rows.some((r) => r.model === m.id));
const stages = results.stages;
const demoSets = results.demo_sets as Record<string, { episodes: number; per_source: Record<string, number>; per_destination: Record<string, number> }>;
const FAMILY = { pi05: 'π0.5', flux3: 'FLUX 3 Action', isaac: 'Isaac 0.5' } as Record<string, string>;
const lo = results.left_out;
const eye = results.eye as Record<string, number>;
const andList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const noted = andList(results.noted_models);
// up to 8 untrained moves are named; more than that are counted, and listed move by move on the Experiments page
const untrMoves = (m: Record<string, number>) => {
  const k = Object.keys(m);
  return k.length <= 8 ? k.map(moveLabel).join(', ') : `${k.length} different moves, each listed with its result on the Experiments page`;
};

const slotRate = (by: Record<string, { rollouts: number; grasped_right: number; released: number }>, pick: 'grasped_right' | 'released') =>
  Object.fromEntries(Object.entries(by).map(([k, v]) => [k, { n: v.rollouts, ok: v[pick] }]));
// per row, in reading order for one column: demonstrations above rollouts, source first. Wide pages put the
// source maps on the left and the destination maps on the right (SlotMaps.astro).
const mapsOf = (r: (typeof rows)[number]): SlotMap[] => {
  const d = r.train_set ? demoSets[r.train_set] : null;
  return [
    ...(d ? [slotDemos(d.per_source, 'source', r.train_set!)] : []),
    slotGot(slotRate(r.by_source, 'grasped_right'), 'source', 'Picked up the right vial, by source slot', 'picked up the right vial',
      d ? untrainedSlots(d.per_source, 'source') : undefined),
    ...(d ? [slotDemos(d.per_destination, 'destination', r.train_set!)] : []),
    slotGot(slotRate(r.by_destination, 'released'), 'destination', 'In the asked slot, by destination', 'ended in the asked slot',
      d ? untrainedSlots(d.per_destination, 'destination') : undefined),
  ];
};
const clips = media.featured as (typeof media.featured)[number][];
const total = results.total;
const count = (r: (typeof rows)[number], key: string) => r.stages[key as keyof typeof r.stages];
const qualified = rows.filter((r) => scoreRun(r.by_destination).verdict !== 'disqualified').length;

// ── How the score is calculated (top) and The score, step by step (bottom) ──
const notTried = (missing: string[], of: number) =>
  missing.length && missing.length < of ? ` (not tried: ${missing.join(', ')})` : '';
type Conf = Record<string, Record<string, number>>;
const CM_SLOTS = [...['L1', 'L2', 'L3', 'L4', 'L5', 'L6'], 'bin', ...['R1', 'R2', 'R3', 'R4', 'R5', 'R6']];
const cmCols = [
  ...CM_SLOTS.map((s) => ({ k: s, label: s, extra: false, title: `Ended at ${s === 'bin' ? 'the bin' : s}` })),
  { k: 'beside', label: 'Dropped beside', extra: true, title: 'Dropped in front of or behind the asked slot' },
  { k: 'held', label: 'Never let go', extra: true, title: 'Carried the vial and never let go' },
  { k: 'none', label: 'Not picked up', extra: true, title: 'Never picked up the asked vial (or took another one)' },
];
const HEAT = [0.2, 0.4, 0.6, 0.8];  // share of the row: five steps of the blue ramp
const sumOf = (o: Record<string, number> = {}) => Object.values(o).reduce((a, b) => a + b, 0);
const colTotal = (c: Conf, k: string) => Object.values(c).reduce((a, r) => a + (r[k] ?? 0), 0);
const endedAt = (k: string, s: string) =>
  k === s ? 'ended in it' : k === 'beside' ? 'dropped beside it' : k === 'held' ? 'never let go'
    : k === 'none' ? 'never picked up the right vial' : `ended at ${k === 'bin' ? 'the bin' : k}`;
const withMatrix = rows.filter((r) => r.confusion);
const pooledText = withMatrix.map((r) => {
  const p = pooled(r.by_destination);
  return `${r.label}: ${p.got} of ${p.n} pooled (${pctOf(p.got / p.n)}) against ${pctOf(scoreRun(r.by_destination).total)} balanced`;
}).join('; ');
const medEx = withMatrix.map((r) => ({ r, med: medianShare(r.by_destination), s: scoreRun(r.by_destination),
  zeros: RACK_SLOTS.filter((x) => r.by_destination[x as keyof typeof r.by_destination]?.rollouts &&
                                  !r.by_destination[x as keyof typeof r.by_destination].released) }))
  .filter((x) => x.med !== null && x.s.total !== null)
  .sort((a, b) => Math.abs(b.med! - 100 * b.s.total!) - Math.abs(a.med! - 100 * a.s.total!))[0];
const medianText = medEx
  ? `${medEx.r.label}: its ${medEx.s.tried} slot shares have a median of ${Math.round(medEx.med!)}% but a mean of ` +
    `${pctOf(medEx.s.total)}. The median does not see ${medEx.zeros.length ? `its ${medEx.zeros.length} slots at 0% (${medEx.zeros.join(', ')})` : 'its weakest slots'}; the mean does.`
  : '';
---
<Base
  page="results"
  title="Results"
  description="Compare any of the models and checkpoints: how far their rollouts got, slot by slot next to what each trained on, and the rollouts themselves."
>
  <section class="section head">
    <div class="wrap">
      <h1>Results</h1>
      <p class="lead">
        {`Tick the models and checkpoints to compare. Every chart, table and video on this page follows the selection. ` +
          `A row is one model at one checkpoint in one mode: nothing is added across checkpoints.`}
      </p>
    </div>
  </section>

  <div class="wrap work">
    <aside class="rail" aria-label="Choose what to compare">
      <details open class="rail-box">
        <summary><h2>Compare</h2><span class="count" id="rail-count" aria-live="polite"></span></summary>
        <div class="rail-actions">
          <button type="button" class="quiet-btn" id="pick-newest">Newest</button>
          <button type="button" class="quiet-btn" id="pick-all">All</button>
          <button type="button" class="quiet-btn" id="pick-none">None</button>
        </div>
        <div class="rail-list">
          {models.map((m) => (
            <div class="rail-model" role="group" aria-label={m.name}>
              <label class="model-box">
                <input type="checkbox" data-model-box={m.id} />
                <i style={`background: var(--m-${m.model})`}></i><strong>{m.name}</strong>
                <span class="note">{FAMILY[m.family]}</span>
              </label>
              <ul>
                {rows.filter((r) => r.model === m.id).map((r) => (
                  <li>
                    <label>
                      <input type="checkbox" data-row-box={r.key} data-of={m.id} />
                      <span>{r.short}</span><span class="note n">{`n = ${r.rollouts}`}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="note rail-foot">
          {`${total} scored rollouts in all. `}<a href={url('experiments/')}>What each model is</a>.
        </p>
      </details>
    </aside>

    <div class="main" id="results-main">
      <section class="block" aria-labelledby="h-score">
        <h2 id="h-score">Score</h2>
        <p>
          {`Every run is scored the same way: at each of the 12 rack slots, the share of its rollouts that ended in the asked slot, ` +
            `then the mean of the 12, with the bin left out. A run passes with at least ${MIN_PER_SLOT} rollouts at every slot and a total of ` +
            `at least ${PASS_MARK * 100}%` + (qualified ? `. ` : `; no run has ${MIN_PER_SLOT} at every slot yet, so all are disqualified, with their numbers still shown. `) +
            `Weak slots shows where the score is lost; every slot's numbers are under `}<a href="#h-slot">Slot by slot</a>{`. `}
          <a href={url('experiments/#score')}>How the score works</a>.
        </p>
        <ScoreTable rows={rows} follow />
        <p class="note empty" id="score-empty" hidden>Nothing ticked. Pick at least one row on the left.</p>
        <div class="calc">
          <h3 id="h-calc">How the score is calculated</h3>
          <p>
            {`It is called `}<Term k="balanced">balanced accuracy</Term>{`: for each slot, the share of the rollouts asked to end ` +
              `there that ended in it, which is the slot's `}<Term k="recall">recall</Term>{`, then the mean of the 12. Every slot counts ` +
              `the same however many rollouts went there, and the bin is left out.`}
          </p>
          <ScoreFormula />
          {rows.map((r) => {
            const tr = workedPart(r.by_destination, TRAINED_SLOTS), ho = workedPart(r.by_destination, HELD_OUT_SLOTS);
            const parts = [
              { tex: workedTex('Trained', tr), what: 'Trained slots', missing: notTried(tr.missing, 6) },
              { tex: workedTex('Held-out', ho), what: 'Held-out slots', missing: notTried(ho.missing, 6) },
            ];
            const total = totalTex([tr, ho], scoreRun(r.by_destination).total);
            return (
              <div class="calc-row" data-row={r.key}>
                <p class="calc-name"><i style={`background: var(--m-${r.family})`}></i>{r.label}</p>
                {parts.map((x) => x.tex
                  ? <><TeX tex={x.tex} display />{x.missing && <p class="calc-note">{`${x.what}${x.missing}.`}</p>}</>
                  : <p class="calc-note">{`${x.what}: no slot tried.`}</p>)}
                {total && <TeX tex={total} display />}
              </div>
            );
          })}
          <p class="note empty" id="calc-empty" hidden>Nothing ticked.</p>
          <p class="note">{`What every term means, and a table of where each vial ended: `}<a href="#score-ref">The score, step by step</a>.</p>
        </div>
      </section>

      <section class="block" aria-labelledby="h-far">
        <div class="block-head">
          <h2 id="h-far">How far each one got</h2>
          <div class="seg-ctl" role="group" aria-label="Bar scale">
            <button type="button" class="quiet-btn" aria-pressed="true" data-scale="count">Number of rollouts</button>
            <button type="button" class="quiet-btn" aria-pressed="false" data-scale="share">Share of its rollouts</button>
          </div>
        </div>
        <StageLegend inline />
        <div class="bars" id="bars" data-mode="count" style="--max: 1">
          <div class="axis" id="axis" aria-hidden="true"></div>
          {rows.map((r) => (
            <div class="bar-row" data-row={r.key}>
              <div class="bar-label"><i style={`background: var(--m-${r.family})`}></i><span>{r.label}</span></div>
              <div class="bar" role="img"
                aria-label={`${r.label}: ${stages.map((s) => `${count(r, s.key)} ${s.label.toLowerCase()}`).join(', ')}`}>
                {stages.map((s, i) => count(r, s.key) > 0 && (
                  <span class="seg" style={`--count: ${count(r, s.key)}; --share: ${(count(r, s.key) / r.rollouts) * 100}; background: var(--st-${i + 1}); color: var(--stt-${i + 1})`}
                    title={`${r.label}\n${s.label}: ${count(r, s.key)} of ${r.rollouts} rollouts`}>{count(r, s.key)}</span>
                ))}
              </div>
              <div class="bar-n num">{`n = ${r.rollouts}`}</div>
              {r.scored_by === 'notes' && (
                <p class="bar-untr">{`Scored from the operator's notes, not the arm: one rollout per noted move` +
                  `${r.restarts ? ` (${r.restarts} restart${r.restarts === 1 ? '' : 's'} counted inside their move)` : ''}. ` +
                  `A vial dropped in front of or behind the slot counts as a failure.`}</p>
              )}
            </div>
          ))}
        </div>
        <p class="note empty" id="bars-empty" hidden>Nothing ticked. Pick at least one row on the left.</p>
        <details class="twin">
          <summary>Show the numbers as a table</summary>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>Model and checkpoint</th><th class="r">Rollouts</th>{stages.map((s) => <th class="r">{s.label}</th>)}<th class="r">Of them, on untrained moves</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr data-row={r.key}><td>{r.label}</td><td class="r num">{r.rollouts}</td>{stages.map((s) => <td class="r num">{count(r, s.key)}</td>)}<td class="r num">{r.untrained?.rollouts ?? 0}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
        <p class="note after">
          {`A rollout is counted once, in the furthest outcome it reached. For models without notes, `}<Term k="letgo">in the asked slot</Term>{` ` +
            `is read from the arm: it let go at the asked slot. A person checked ${eye.checked} of those rollouts: the vial was in the slot ` +
            `${eye.in_slot} times, not in it ${eye.not_in_slot} times (those count as not in the asked slot, whatever the arm did), and could ` +
            `not be told ${eye.unclear} times.` +
            (noted ? ` ${noted} are scored from the operator's notes at the robot, move by move, and a vial dropped in front of or behind the slot is a failure.` : '')}
        </p>
      </section>

      <section class="block" aria-labelledby="h-slot">
        <h2 id="h-slot">Slot by slot</h2>
        <p>
          {`Where on the table each ticked row succeeded, next to what it trained on: the demonstrations of its own training set ` +
            `(the models trained on 100 and on 220 demonstrations differ). The racks are drawn as on the table: left rack, bin, ` +
            `right rack, slots 1 to 6 in each. The number under a slot is what counts. Four rows are shown at most.`}
        </p>
        <ul class="legend slot-key">
          <li><i class="k-got"></i>{`Rollouts: how many got through, of how many started or ended at that slot`}</li>
          <li><i class="k-demo"></i>{`Demonstrations: how many of its training set started or ended there`}</li>
          <li><i class="k-none"></i>{`Empty: none there`}</li>
          <li><i class="k-untr"></i>{`Dashed ring: an untrained slot, one its training set never used in that role (2 and 5 as a source; 2, 4 and 5 as a destination)`}</li>
        </ul>
        {rows.map((r) => (
          <div class="slot-row" data-row={r.key}>
            <h3><i style={`background: var(--m-${r.family})`}></i>{r.label}<span class="sub">{`${r.rollouts} rollouts` +
              (r.train_set ? `, trained on ${r.train_set} (${demoSets[r.train_set].episodes} demonstrations)` : '')}</span></h3>
            {(() => {
              const s = scoreRun(r.by_destination);
              return (
                <p class="slot-score">
                  <span>{`Trained slots (1, 3, 6): `}<strong>{pctOf(s.trained)}</strong></span>
                  <span>{`Untrained slots (2, 4, 5): `}<strong>{pctOf(s.held)}</strong></span>
                  <span>{`All slots, the average: `}<strong>{pctOf(s.total)}</strong></span>
                  <span class="how">{`in the asked slot, the mean over the slots it was tried at`}</span>
                </p>
              );
            })()}
            <SlotMaps maps={mapsOf(r)} />
            {r.untrained && (
              <p class="note split">{`${r.rollouts - r.untrained.rollouts} of the ${r.rollouts} rollouts were on moves it was trained on, ` +
                `${r.untrained.rollouts} on moves it was never trained on (${untrMoves(r.untrained.moves)}).`}</p>
            )}
          </div>
        ))}
        <p class="note empty" id="slots-empty" hidden>Nothing ticked.</p>
        <p class="note after" id="slots-more" hidden>More than four rows are ticked: the first four are shown.</p>
      </section>

      <section class="block" aria-labelledby="h-watch">
        <h2 id="h-watch">Rollouts to watch</h2>
        <p>
          {`Rollouts of the ticked rows, every camera the model saw at once. They loop; click one to pause it. ` +
            `Filter by how far they got:`}
        </p>
        <div class="seg-ctl stage-filter" role="group" aria-label="Show rollouts that reached">
          {stages.map((s, i) => (
            <button type="button" class="quiet-btn" aria-pressed="true" data-stage={s.key}><i style={`background: var(--st-${i + 1})`}></i>{s.label}</button>
          ))}
        </div>
        <div class="clips">
          {clips.map((f) => (
            <div class="clip-wrap" data-row={f.row} data-stage={f.stage}>
              <Clip src={f.src} poster={f.poster} w={f.w} h={f.h} caption={f.caption} move={f.move}
                vialAt={f.at ?? undefined} missAt={f.miss ?? undefined} vial={(f.vial ?? 'neutral') as 'red'} used={f.used} outcome={f.stage} kind={f.kind} />
            </div>
          ))}
        </div>
        <p class="note empty" id="clips-empty" hidden>No rollout of the ticked rows matches. Only some rollouts were picked to be shown.</p>
      </section>

      <section class="block" aria-labelledby="h-cannot">
        <h2 id="h-cannot">What these numbers cannot say</h2>
        <p>
          {`They are small. The biggest row has ${Math.max(...rows.map((r) => r.rollouts))} rollouts and many have one to five, so one more ` +
            `good or bad rollout moves a row a long way, and the rows are not a controlled comparison: they differ in training data, ` +
            `length and mode. These were test runs during development, and the moves are uneven. The scorer reads the arm, not the vial` +
            (noted ? ` (${noted} are scored from the operator's notes instead). ` : '. ') +
            `The counts include ${results.untrained} rollouts on moves no demonstration contains; under each row in Slot by slot it says how many. ` +
            `Left out: ${lo.short} rollouts under 3 seconds, ${lo.unreadable} with a command ` +
            `the scorer cannot read` + (lo.restart ? `, ${lo.earlier_scene} from an earlier table layout and ${lo.restart} restarts of a move ` +
              `the operator noted once` : ` and ${lo.earlier_scene} from an earlier table layout`) + `. For a person-scored evaluation of a different, earlier ` +
            `system see `}<a href={url('previous/results/')}>the August evaluation</a>{`; the two should not be compared.`}
        </p>
      </section>

      <section class="block" aria-labelledby="h-ref" id="score-ref">
        <h2 id="h-ref">The score, step by step</h2>
        <p>{`What every word of the score means, from one rollout to the verdict, and then where every vial of the ticked rows ended.`}</p>
        <ol class="ref-steps">
          <li>
            <strong>One rollout asks for one slot.</strong>{` For a slot s, a true positive `}<TeX tex={String.raw`\mathrm{TP}_s`} />{` is a rollout ` +
              `asked to end in s whose vial ended in s. A false negative `}<TeX tex={String.raw`\mathrm{FN}_s`} />{` is a rollout asked for s whose vial ` +
              `ended anywhere else: at another slot, beside s, still in the gripper, or never picked up. There are no true negatives: ` +
              `every rollout asks for some slot, so doing nothing is never the right answer.`}
          </li>
          <li>
            <strong>{`A slot's share is its `}<Term k="recall">recall</Term>.</strong>{` It is the number under each destination in `}
            <a href="#h-slot">Slot by slot</a>{`, and the Recall column of the tables below.`}
            <TeX tex={String.raw`\text{recall}_s = \text{share}(s) = \frac{\mathrm{TP}_s}{\mathrm{TP}_s + \mathrm{FN}_s}`} display />
          </li>
          <li>
            <strong>{`The total is the `}<Term k="balanced">balanced accuracy</Term>.</strong>{` The mean of the 12 recalls, the bin left ` +
              `out. Pooling every rollout instead (plain accuracy) would let the slots a run was tried at most decide its score.`}
            <TeX tex={String.raw`\text{balanced accuracy} = \frac{1}{12} \sum_{s \in S} \text{recall}_s \qquad ` +
              String.raw`\text{plain accuracy} = \frac{\sum_{s \in S} \mathrm{TP}_s}{\sum_{s \in S} \left(\mathrm{TP}_s + \mathrm{FN}_s\right)}`} display />
            {pooledText && <span>{`${pooledText}.`}</span>}
          </li>
          <li>
            <strong>Trained and held-out.</strong>{` The same mean over slots 1, 3 and 6 of both racks, the destinations the ` +
              `demonstrations used, and over slots 2, 4 and 5, which no demonstration used as a destination: the untrained slots ` +
              `ringed in Slot by slot.`}
          </li>
          <li>
            <strong>Pass and weak.</strong>{` A run passes with at least ${MIN_PER_SLOT} rollouts at every one of the 12 slots and a ` +
              `total of at least ${PASS_MARK * 100}%. A slot at ${WEAK_AT * 100}% or below is weak.`}
            <TeX tex={`\\text{pass} \\iff n_s \\ge ${MIN_PER_SLOT} \\text{ for every } s \\in S \\text{ and } \\text{Total} \\ge ${PASS_MARK * 100}\\,\\% ` +
              `\\qquad \\text{weak}(s) \\iff \\text{share}(s) \\le ${WEAK_AT * 100}\\,\\%`} display />
          </li>
          <li>
            <strong>The mean, not the median.</strong>{` ${medianText}`}
          </li>
        </ol>

        <h3 id="h-cm">Where every vial ended</h3>
        <p>
          {`A `}<Term k="confusion">confusion matrix</Term>{` for each ticked row scored from the operator's notes. A row is the ` +
            `slot asked for; a column is where the vial ended: at a slot (in it, or beside it when it was not the asked slot), ` +
            `beside the asked slot, still held, or never picked up. The outlined cell on the diagonal counts the rollouts that ` +
            `ended in the asked slot (TP); the rest of the row are its misses (FN). Recall, on the right, is the share the score ` +
            `uses. `}<Term k="precision">Precision</Term>{`, at the bottom, is how many of the vials that ended at a slot were ` +
            `asked to end there; a false positive `}<TeX tex={String.raw`\mathrm{FP}_s`} />{` is a vial that ended at s while another slot was asked.`}
        </p>
        <TeX tex={String.raw`\text{precision}_s = \frac{\mathrm{TP}_s}{\mathrm{TP}_s + \mathrm{FP}_s}`} display />
        <ul class="legend cm-key">
          {HEAT.concat(1).map((b, i) => <li><i style={`background: var(--ob-${i + 1})`}></i>{`up to ${Math.round(b * 100)}% of the row`}</li>)}
          <li><i class="k-diag"></i>{`the asked slot`}</li>
        </ul>
        {rows.map((r) => {
          const c = r.confusion as Conf | null;
          if (!c) return (
            <p class="cm-row cm-none" data-row={r.key}>{`${r.label}: scored from the arm, which reads where the gripper let go ` +
              `but cannot see where the vial ended, so it has no table.`}</p>
          );
          return (
            <div class="cm-row" data-row={r.key}>
              <p class="calc-name"><i style={`background: var(--m-${r.family})`}></i>{r.label}{' '}<span class="sub">{`${r.rollouts} rollouts`}</span></p>
              <div class="table-scroll">
                <table class="cm">
                  <caption class="visually-hidden">{`Where each vial of ${r.label} ended, by the slot asked for`}</caption>
                  <thead>
                    <tr>
                      <th scope="col" class="corner">Asked ↓ · ended →</th>
                      {cmCols.map((col) => <th scope="col" class:list={['ch', { extra: col.extra }]} title={col.title}>{col.label}</th>)}
                      <th scope="col" class="r">Recall</th>
                    </tr>
                  </thead>
                  <tbody>
                    {CM_SLOTS.map((s) => {
                      const row = c[s] ?? {}, n = sumOf(row);
                      return (
                        <tr class:list={{ none: !n }}>
                          <th scope="row">{s}</th>
                          {cmCols.map((col) => {
                            const v = row[col.k] ?? 0, k = v ? byBounds(v / n, HEAT) : 0;
                            return (
                              <td class:list={['cell', { diag: col.k === s, on: v > 0 }]}
                                style={v ? `--bg: var(--ob-${k}); --fg: var(--obt-${k})` : undefined}
                                title={v ? `Asked for ${s}, ${endedAt(col.k, s)}: ${v} of ${n}` : undefined}>{v || ''}</td>
                            );
                          })}
                          <td class="r rec">{n ? `${row[s] ?? 0}/${n} = ${pctOf((row[s] ?? 0) / n)}` : '–'}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                  <tfoot>
                    <tr>
                      <th scope="row">Precision</th>
                      {cmCols.map((col) => {
                        const tot = col.extra ? 0 : colTotal(c, col.k);
                        return <td class="prec">{tot ? `${c[col.k]?.[col.k] ?? 0}/${tot}` : ''}</td>;
                      })}
                      <td></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
              {c.bin && <p class="note">{`The bin row is shown for completeness; the score leaves it out.`}</p>}
            </div>
          );
        })}
        <p class="note empty" id="cm-empty" hidden>Nothing ticked.</p>
        <p class="note after" id="cm-more" hidden>More than four rows are ticked: the first four are shown.</p>
        <p class="note">{`Why the rule is built this way, as agreed with the supervisor: `}<a href={url('experiments/#score')}>How a run is scored</a>.</p>
      </section>
    </div>
  </div>
</Base>

