---
import Base from '../layouts/Base.astro';
import experiments from '../data/experiments.json';
import { url } from '../lib/site';

// The Experiments page was split in three: Testing (how rollouts are run and scored), Models (what each model is) and
// Glossary. This address is kept so old links still arrive: the script sends an address with a part after the #
// to the page that part now lives on, and the page itself lists the three.
const ids = experiments.models.map((m) => m.id);
---
<Base
  page="method"
  title="Experiments"
  description="The Experiments page is now three pages: Testing, Models and Glossary."
>
  <section class="section">
    <div class="wrap">
      <h1>This page is now three</h1>
      <p class="lead">What used to be on Experiments is split by what you are looking for.</p>
      <ul class="moved" data-models={ids.join(',')} data-method={url('method/')} data-model-page={url('models/')} data-glossary={url('glossary/')}>
        <li><a href={url('method/')}>Testing</a><span class="note">How a rollout is run and scored, the score of a run, how to read the results, and what the numbers cannot say.</span></li>
        <li><a href={url('models/')}>Models</a><span class="note">{`All ${ids.length} models, and each one in full with its settings.`}</span></li>
        <li><a href={url('glossary/')}>Glossary</a><span class="note">The words the site uses in a defined sense.</span></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('.moved')!;
  const hash = location.hash.slice(1);
  const models = new Set(list.dataset.models!.split(','));
  const to = !hash ? list.dataset.method!
    : models.has(hash) ? `${list.dataset.modelPage}#${hash}`
    : hash.startsWith('g-') ? `${list.dataset.glossary}#${hash}`
    : `${list.dataset.method}#${hash}`;
  location.replace(to);
</script>

<style>
  .moved { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.1rem; }
  .moved li { display: grid; gap: 0.15rem; }
  .moved li > a { font-size: var(--step-1); font-stretch: 112%; font-weight: 560; width: fit-content; }
</style>
