{
 "stages": [
  {
   "key": "no_grasp",
   "label": "Missed the vial",
   "def": "The gripper never closed on the vial in the asked source slot: it closed on another slot, on an empty hole, or not at all."
  },
  {
   "key": "grasped",
   "label": "Grasped, not lifted",
   "def": "The gripper closed on the right vial but the arm never lifted it."
  },
  {
   "key": "carried",
   "label": "Lifted, let go elsewhere or not at all",
   "def": "The arm lifted the right vial, then let go at a different slot or never let go before the rollout ended."
  },
  {
   "key": "released",
   "label": "Let go at the asked slot",
   "def": "The arm let go at the slot the command asked for (within half a slot). It does not prove the vial ended in the hole: the scorer reads the arm, not the vial."
  }
 ],
 "funnel": [
  {
   "key": "rollouts",
   "label": "Rollouts"
  },
  {
   "key": "grasped_right",
   "label": "Grasped the right vial"
  },
  {
   "key": "lifted",
   "label": "Lifted it"
  },
  {
   "key": "released",
   "label": "Let go at the asked slot"
  }
 ],
