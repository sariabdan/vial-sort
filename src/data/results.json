{
 "stages": [
  {
   "key": "no_grasp",
   "label": "Missed the vial",
   "def": "The gripper never closed on the vial in the asked source slot: it closed on another slot, on an empty hole, or not at all."
  },
  {
   "key": "grasped",
   "label": "Grasped, not lifted",
   "def": "The gripper closed on the right vial but the arm never lifted it."
  },
  {
   "key": "carried",
   "label": "Lifted, not in the asked slot",
   "def": "The arm lifted the right vial, but it did not end in the asked slot: let go at another slot, dropped in front of or behind the asked slot, or never let go before the rollout ended."
  },
  {
   "key": "released",
   "label": "In the asked slot",
   "def": "The vial ended in the asked slot. With the operator's notes, that is what the operator saw. Scored from the arm, it is the arm letting go at the asked slot (within half a slot), unless a person saw the vial was not in it."
  }
 ],
