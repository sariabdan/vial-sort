---
// One recorded rollout: the video, the asked move on a small rack, and what happened.
import RackGlyph from './RackGlyph.astro';
import CameraChips from './CameraChips.astro';
import { url, moveLabel } from '../lib/site';

interface Props {
  src: string;
  poster: string;
  w: number;
  h: number;
  caption: string;
  move?: string | null;
  vialAt?: string;
  missAt?: string;
  vial?: 'red' | 'lime' | 'cyan';
  label?: string;
  /** cameras the model saw; the clip shows every feed the session recorded */
  used?: string[];
  /** the outcome (stage key) and a one-line label of what kind of rollout this is, shown above the video */
  outcome?: string | null;
  kind?: string | null;
}
const { src, poster, w, h, caption, move, vialAt, missAt, vial, label, used, outcome, kind } = Astro.props;
const STAGE_NUM: Record<string, number> = { no_grasp: 1, carried: 2, released: 3 };
---
<figure class="clip" style={outcome && STAGE_NUM[outcome] ? `--oc: var(--st-${STAGE_NUM[outcome]})` : undefined}>
  {(kind || move) && (
    <p class="clip-top">
      {kind && <span class="kind"><i></i>{kind}</span>}
      {move && <span class="move">{moveLabel(move)}</span>}
    </p>
  )}
  <div class="frame">
    <video src={url(src)} poster={url(poster)} width={w} height={h} muted loop playsinline data-auto preload="metadata"
      aria-label={label ?? `Recorded rollout, ${moveLabel(move)}`}></video>
    <button type="button" class="fs" data-fullscreen aria-label="Show this video full screen" title="Full screen">Full screen</button>
  </div>
  <figcaption>
    {move && <RackGlyph asked={move} vialAt={vialAt} missAt={missAt} vial={vial} />}
    <p>{caption}</p>
    {used && <p class="cams"><span class="note">Cameras the model saw: </span><CameraChips used={used} /></p>}
  </figcaption>
</figure>
<script>
  // The vial on each card's small rack moves while its video plays: from the slot it started in to where it ended
  // (the asked slot, another slot, held over one, or nowhere when it was never picked up), lifted over the racks on
  // the way. The clips have no grasp and release times, so the dot follows the video's progress, not the exact moment:
  // it is a picture of the move, not a clock. Paused, before the first play, and with reduced motion, it shows the end.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.clip').forEach((clip) => {
    const video = clip.querySelector('video');
    const glyph = clip.querySelector<SVGSVGElement>('.rack-glyph');
    const vial = glyph?.querySelector<SVGCircleElement>('[data-vial]');
    const from = glyph?.querySelector<SVGCircleElement>(`[data-slot="${glyph.dataset.src}"]`);
    if (reduce || !video || !glyph || !vial || !from) return;
    const end = { x: Number(vial.getAttribute('cx')), y: Number(vial.getAttribute('cy')) };
    const start = { x: Number(from.getAttribute('cx')), y: Number(from.getAttribute('cy')) };
    if (start.x === end.x && start.y === end.y) return;  // never picked up: the vial stays where it is
    const lift = Math.min(24, 8 + Math.abs(end.x - start.x) / 9);
    const place = (p: number) => {
      const e = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
      vial.setAttribute('cx', String(start.x + (end.x - start.x) * e));
      vial.setAttribute('cy', String(start.y + (end.y - start.y) * e - Math.sin(Math.PI * e) * lift));
    };
    // still at the source for the first fifth of the clip, at the end for the last fifth
    const sync = () => place(video.paused || !video.duration ? 1 : Math.min(1, Math.max(0, (video.currentTime / video.duration - 0.2) / 0.6)));
    const frame = () => { sync(); if (!video.paused) requestAnimationFrame(frame); };
    video.addEventListener('play', () => requestAnimationFrame(frame));
    video.addEventListener('timeupdate', sync);  // keeps it right after a seek, and where the browser pauses animation frames
    video.addEventListener('pause', sync);
  });
</script>

<style>
  /* a card: the outcome and the asked move on one line, the video, the racks at the card's full width, the note.
     The top edge carries the outcome's colour. */
  .clip { --oc: var(--steel); margin: 0; display: grid; gap: 0.55rem; align-content: start; padding: 0.65rem 0.7rem 0.75rem;
          border: 1px solid var(--rule); border-top: 3px solid var(--oc); border-radius: 10px; background: var(--raise); }
  .clip-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.1rem 0.8rem; margin: 0; color: var(--ink); }
  .kind { display: inline-flex; align-items: baseline; gap: 0.45rem; font-size: 0.95rem; font-weight: 620; line-height: 1.25; }
  .kind i { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; background: var(--oc); }
  .clip-top .move { font-size: 1.05rem; white-space: nowrap; }
  .frame { position: relative; line-height: 0; }
  video { display: block; width: 100%; height: auto; background: var(--page); border-radius: 6px; cursor: pointer; }
  figcaption { display: grid; gap: 0.4rem; }
  figcaption :global(.rack-glyph) { max-width: 30rem; }
  figcaption :global(.rack-glyph .slot), figcaption :global(.rack-glyph .bin) { stroke-width: 1.6; }
  figcaption :global(.rack-glyph .arc) { stroke-width: 1.8; opacity: 1; }
  figcaption p { font-size: 0.86rem; line-height: 1.45; color: var(--ink-2); margin: 0; }
  .cams { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
</style>