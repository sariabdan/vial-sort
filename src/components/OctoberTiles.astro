---
// The four numbers the home page leads with, each with its n and the checkpoint it comes from. Counts, not
// rates: the rows are small, and a percentage of five rollouts would look more certain than it is.
import results from '../data/results.json';

// compact: the same four tiles at a smaller size, for the first screen of the home page
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const t = results.tiles;
const p = t.pi05, f = t.flux, g = t.gate;
const tiles = [
  { big: p.grasped_right, of: p.rollouts, text: 'rollouts picked up the right vial', note: `${p.name} (π0.5), ${p.short}.` },
  { big: p.released, of: p.rollouts, text: 'of those ended in the slot the command asked for', note: p.scored_by === 'notes' ? `From the operator's notes; a vial dropped beside the slot counts as a failure.` : 'Read from the arm, not the vial.' },
  { big: f.grasped_right, of: f.rollouts, text: 'rollouts picked up the right vial', note: `${f.name} (FLUX 3 Action), ${f.short}. ${f.released} of ${f.rollouts} in the asked slot, read from the arm.` },
  { big: g.dest_passed, of: g.checkpoints, text: 'checkpoints read the destination slot in the offline test', note: `Mango Rice, October. The source slot is read from ${g.source_from / 1000}k steps on.` },
];
---
<ul class:list={['tiles', compact && 'compact']}>
  {tiles.map((x) => (
    <li>
      <span class="value">{x.big}<span class="of">{` of ${x.of}`}</span></span>
      <span class="text">{x.text}</span>
      <span class="note">{x.note}</span>
    </li>
  ))}
</ul>

<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem clamp(1rem, 3vw, 2.5rem); }
  li { display: grid; align-content: start; gap: 0.3rem; padding-top: 0.9rem; border-top: 2px solid var(--ink); }
  .value { font-size: var(--step-5); font-weight: 600; line-height: 1; font-stretch: 112%; white-space: nowrap; }
  .of { font-size: var(--step-1); font-weight: 500; color: var(--ink-2); font-stretch: 100%; }
  .text { max-width: 22ch; line-height: 1.35; }
  .compact li { padding-top: 0.6rem; gap: 0.15rem; }
  .compact .value { font-size: var(--step-3); }
  .compact .of { font-size: var(--step-0); }
  .compact .text { max-width: 26ch; font-size: var(--step--1); color: var(--ink); }
  .compact .note { font-size: 0.95rem; line-height: 1.4; }
  @media (max-width: 52rem) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
