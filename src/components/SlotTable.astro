---
// One ticked row slot by slot, in the order of the table: left rack slots 1–6, the bin, right rack slots 1–6.
// A "got through" cell is a vial filled to the share of the rollouts there that got through, with the count under it;
// the row's own training demonstrations are printed under the same slot. One neutral colour: the fill level and the
// count carry the number, not a shade (the boss: the green shades of the old maps washed into each other, and their
// numbers were drawn into a picture that shrank with the page). Real text, so it never gets smaller than the page's.

export interface SlotPart {
  title: string;                                // the part's heading row
  what: string;                                 // row label of the vial row
  role: 'source' | 'destination';
  verb: string;                                 // "picked up the right vial", for the tooltip
  got: Record<string, { n: number; ok: number }>;
  demos: Record<string, number> | null;         // per slot, from the row's own training set
}
interface Props { label: string; set: string | null; parts: SlotPart[] }
const { label, set, parts } = Astro.props;

const LEFT = [1, 2, 3, 4, 5, 6].map((n) => `L${n}`);
const RIGHT = [1, 2, 3, 4, 5, 6].map((n) => `R${n}`);
const COLS = [...LEFT, 'bin', ...RIGHT];
const place = (c: string) => (c === 'bin' ? 'The bin' : c);
// the rack groups are kept apart by a rule left of the bin and left of R1
const edge = (c: string) => (c === 'bin' ? 'bin' : c === 'R1' ? 'g' : undefined);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
---
<div class="slot-wrap">
<p class="swipe note" aria-hidden="true">Swipe the table sideways for the bin and the right rack.</p>
<div class="table-scroll">
  <table class="slots">
    <caption class="visually-hidden">{`${label}, slot by slot`}</caption>
    <colgroup><col class="lab" />{LEFT.map(() => <col />)}<col class="binc" />{RIGHT.map(() => <col />)}</colgroup>
    <thead>
      <tr>
        <td class="lab corner" rowspan="2"></td>
        <th colspan="6" scope="colgroup">Left rack</th>
        <th rowspan="2" scope="col" class="bin rack-bin">Bin</th>
        <th colspan="6" scope="colgroup" class="g">Right rack</th>
      </tr>
      <tr>
        {LEFT.map((c) => <th scope="col" class="slot-n" aria-label={c}>{c[1]}</th>)}
        {RIGHT.map((c) => <th scope="col" class:list={['slot-n', edge(c)]} aria-label={c}>{c[1]}</th>)}
      </tr>
    </thead>
    {parts.map((p) => (
      <tbody>
        <tr class="part"><th colspan="14" scope="rowgroup" class="lab"><span>{p.title}</span></th></tr>
        <tr class="got">
          <th scope="row" class="lab">{p.what}</th>
          {COLS.map((c) => {
            if (c === 'bin' && p.role === 'source') return <td class="bin none" title="The bin is never a source">–</td>;
            const g = p.got[c];
            if (!g || !g.n) return <td class:list={[edge(c), 'none']} title={`${place(c)} as the ${p.role}: no rollouts`}>–</td>;
            return (
              <td class={edge(c)} title={`${place(c)} as the ${p.role}: ${g.ok} of ${plural(g.n, 'rollout')} ${p.verb}`}>
                <span class="vial-meter" style={`--p: ${((g.ok / g.n) * 100).toFixed(1)}`} aria-hidden="true"></span>
                <span class="k" aria-hidden="true">{`${g.ok}/${g.n}`}</span>
                <span class="visually-hidden">{`${g.ok} of ${g.n}`}</span>
              </td>
            );
          })}
        </tr>
        {p.demos && (
          <tr class="demo">
            <th scope="row" class="lab" title={set ? `Demonstrations in ${set}` : undefined}>Demonstrations</th>
            {COLS.map((c) => {
              if (c === 'bin' && p.role === 'source') return <td class="bin none" title="The bin is never a source">–</td>;
              const v = p.demos![c] ?? 0;
              return <td class={edge(c)} title={`${place(c)} as the ${p.role}: ${plural(v, 'demonstration')}`}>{v}</td>;
            })}
          </tr>
        )}
      </tbody>
    ))}
  </table>
</div>
</div>

<style>
  .slots { border-collapse: separate; border-spacing: 0; table-layout: fixed; width: 100%; max-width: 68rem; min-width: 46rem;
           font-variant-numeric: tabular-nums; }
  col.lab { width: 11.5rem; }
  col.binc { width: 5.4rem; }
  th, td { padding: 0.3rem 0.15rem; text-align: center; font-weight: 400; }
  thead th { font-size: var(--step-0); font-weight: 620; color: var(--ink); padding-bottom: 0.1rem; }
  thead .slot-n { font-weight: 500; color: var(--ink-2); padding-bottom: 0.45rem; border-bottom: 1px solid var(--rule); }
  thead .rack-bin { vertical-align: bottom; padding-bottom: 0.45rem; border-bottom: 1px solid var(--rule); }
  .bin, .g { border-left: 1px solid var(--rule); }
  /* the labels stay in view when a narrow screen scrolls the table sideways */
  .lab { position: sticky; left: 0; z-index: 1; background: var(--page); text-align: left; padding-right: 0.8rem; }
  .corner { border-bottom: 1px solid var(--rule); }
  .part th { font-size: var(--step-0); font-weight: 650; color: var(--ink); padding: 1.1rem 0 0.2rem; position: static; }
  .part th span { position: sticky; left: 0; }
  tbody + tbody .part th { border-top: 1px solid var(--rule); }
  .got th, .demo th { font-size: var(--step-0); color: var(--ink); line-height: 1.3; }
  .got th { vertical-align: bottom; padding-bottom: 0.35rem; }
  .got td { vertical-align: bottom; padding-top: 0.6rem; }
  .k { display: block; font-size: 1.25rem; font-weight: 680; line-height: 1.25; color: var(--ink); white-space: nowrap; }
  .demo td { font-size: var(--step-0); color: var(--ink-2); padding-top: 0.2rem; padding-bottom: 0.4rem; }
  td.none { color: var(--steel); font-size: 1.25rem; }
  .demo td.none { font-size: var(--step-0); }
  /* sized by the room the table has, not the screen: the side panel and browser zoom change it too */
  .slot-wrap { container-type: inline-size; }
  .swipe { display: none; margin-bottom: 0.4rem; }
  @container (max-width: 47rem) {
    .slots { min-width: 39rem; }
    col.lab { width: 8rem; }
    col.binc { width: 4.6rem; }
    .lab { padding-right: 0.5rem; }
    .got th, .demo th { font-size: var(--step--1); }
    .k, td.none { font-size: 1.1rem; }
  }
  /* narrower still (phones): the table keeps that size and scrolls sideways under the sticky labels; a line says so */
  @container (max-width: 38.95rem) { .swipe { display: block; } }
</style>
