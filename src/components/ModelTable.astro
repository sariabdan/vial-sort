---
// Every policy tried, what it cost to train, and what it did on the robot. Measured rows come from
// training logs; the rest say where their numbers come from. Gaps stay gaps: "not logged" for a
// run that happened, a dash for a policy that was never trained.
import models from '../data/models.json';
import { MODELS } from '../lib/site';

type Row = (typeof models.rows)[number];
interface Props { eras: ('paper' | 'after' | 'planned' | 'considered')[] }
const { eras } = Astro.props;
const TITLES: Record<string, string> = {
  paper: 'The August policies (Thor rig, three cameras)',
  after: 'October runs (workstation rig, five cameras)',
  planned: 'Planned next',
  considered: 'Considered, not trained',
};
const trained = (r: Row) => r.era === 'paper' || r.era === 'after';
const robot = (r: Row) => {
  const t = r.robot as null | { rollouts?: number; complete?: number; takes?: number; released?: number; right_vial?: number };
  if (t?.rollouts != null) return `${t.complete} of ${t.rollouts} rollouts complete, scored by a person.`;
  if (t?.takes != null) return `${t.takes} scored rollouts. Each checkpoint has its own row on the Experiments page.`;
  return null;
};
---
<div class="table-scroll">
  <table class="data models">
    <thead>
      <tr>
        <th>Policy</th><th>What was trained</th><th>Data</th><th class="r">Steps</th><th class="r">Training time</th>
        <th class="r">Peak GPU memory</th><th>On the robot</th><th>Source</th>
      </tr>
    </thead>
    {eras.map((era) => (
      <tbody>
        <tr class="group"><th colspan="8">{TITLES[era]}</th></tr>
        {models.rows.filter((r) => r.era === era).map((r) => (
          <tr>
            <td>
              <div class="policy">
                {r.model && <i style={`background: ${MODELS[r.model].color}`}></i>}
                <span>{r.name}</span>
              </div>
              {r.model && <span class="note">{MODELS[r.model].label}</span>}
            </td>
            <td>{r.trained ?? <span class="gap">–</span>}</td>
            <td>{r.data ?? <span class="gap">–</span>}</td>
            <td class="r">{r.steps ?? <span class="gap">–</span>}</td>
            <td class="r">{r.time ?? <span class="gap">{trained(r) ? 'not logged' : '–'}</span>}</td>
            <td class="r">{r.memory ?? <span class="gap">{trained(r) ? 'not logged' : '–'}</span>}</td>
            <td>
              {robot(r) ?? r.verdict}
              {r.rate_hz && <span class="note"> Ran at {r.rate_hz} Hz against a 30 Hz target.</span>}
            </td>
            <td class="note">{r.source}</td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>

<style>
  .models { min-width: 60rem; font-size: var(--step--1); }
  .models td, .models th { padding-right: 1.1rem; }
  .group th { padding-top: 1.1rem; font-size: var(--step-0); border-bottom: 1px solid var(--rule); }
  .policy { display: flex; gap: 0.5rem; align-items: baseline; font-weight: 560; color: var(--ink); min-width: 11rem; }
  .policy i { width: 0.7rem; height: 0.7rem; border-radius: 50%; flex: none; transform: translateY(0.05rem); }
  .gap { color: var(--steel); }
</style>
