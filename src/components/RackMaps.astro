---
// Per-slot counts or rates drawn on the rack layout (bin, left rack, right rack; slots 1–6 left to
// right). The page builds the cells (src/lib/rackmaps.ts) and says what the colours mean. Used by the August page;
// Results draws its slots with SlotMaps.astro.
import type { RackMap } from '../lib/rackmaps';

interface Props { maps: RackMap[] }
const { maps } = Astro.props;
// bigger slots and numbers than before (the boss: 'insanely small'): about 15 px numbers at a half-row width
const P = 31, Y = 22, R = 12, LEFT0 = 26, BIN = 238, RIGHT0 = 298;
const x = (c: string) => (c === 'bin' ? BIN : (c[0] === 'L' ? LEFT0 : RIGHT0) + (Number(c[1]) - 1) * P);
---
<div class="maps">
  {maps.map((m) => (
    <figure class="map">
      <figcaption>{m.caption}</figcaption>
      <svg viewBox="0 0 470 66" role="img" aria-label={m.caption}>
        <rect x={LEFT0 - 17} y={Y - 17} width={5 * P + 34} height="34" rx="17" class="bar" />
        <rect x={RIGHT0 - 17} y={Y - 17} width={5 * P + 34} height="34" rx="17" class="bar" />
        {m.cells.map((c) => (c.code === 'bin' ? (
          <g>
            <title>{c.title}</title>
            <rect x={BIN - 30} y={Y - 18} width="60" height="36" rx="6" class="bin"
              style={c.cls ? `fill: var(--${m.ramp}-${c.cls}); stroke: none` : undefined} />
            <text x={BIN} y={Y + 5} text-anchor="middle" class="in"
              style={c.cls ? `fill: var(--${m.ramp}t-${c.cls})` : undefined}>{c.text}</text>
          </g>
        ) : (
          <g>
            <title>{c.title}</title>
            <circle cx={x(c.code)} cy={Y} r={R} class="slot"
              style={c.cls ? `fill: var(--${m.ramp}-${c.cls}); stroke: none` : undefined} />
            <text x={x(c.code)} y={Y + 37} text-anchor="middle" class="count">{c.text}</text>
          </g>
        )))}
      </svg>
    </figure>
  ))}
</div>

<style>
  .maps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem clamp(1rem, 3vw, 2.5rem); }
  .map { margin: 0; }
  figcaption { font-size: var(--step-0); color: var(--ink); margin-bottom: 0.35rem; }
  svg { width: 100%; height: auto; overflow: visible; }
  .bar { fill: var(--grid); }
  .slot, .bin { fill: var(--page); stroke: var(--rack); stroke-width: 1.25; }
  .count, .in { font-family: var(--font); font-size: 14px; fill: var(--ink); font-variant-numeric: tabular-nums; }
  .in { font-size: 14px; font-weight: 650; }
  @media (max-width: 40rem) { .maps { grid-template-columns: minmax(0, 1fr); } }
</style>
