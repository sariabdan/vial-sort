---
// Every move one run (model + checkpoint + mode) was asked on the robot, for Results' "Every move": one line per run,
// its moves side by side as small cards in the order they were run, scrolling to the right. A run scored from the
// operator's notes has a card per noted move, with the note as written and a marker where a new day starts; a run
// scored from the arm has a card per move with how far its rollouts got.
import experiments from '../data/experiments.json';
import { moveLabel } from '../lib/site';

type Row = (typeof experiments.rows)[number];
interface Props { r: Row }
const { r } = Astro.props;
const stages = experiments.stages;
const OUTCOME: Record<string, string> = {
  placed: 'In the slot', drop_missed: 'Dropped beside the asked slot', off_slot: 'Let go at another slot',
  never_let_go: 'Never let go', no_grasp: 'Never picked it up', wrong_vial: 'Took another vial',
};
const stageIdx = (key: string) => stages.findIndex((s) => s.key === key);
const fromOf = (move: string) => move.split('->')[0];
// the day a noted rollout was recorded, from its take id (<step>_<yyyymmdd>_<hhmmss>_t<n>)
const dayOf = (take: string) => {
  const m = take.match(/_(\d{4})(\d{2})(\d{2})_\d{6}_t\d+$/);
  return m ? new Date(`${m[1]}-${m[2]}-${m[3]}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) : '';
};
const endedText = (ended: string | null, move: string) =>
  ended === null ? '' : ended === 'source' ? `still in ${fromOf(move)}` : ended === 'bin' ? 'ended in the bin'
    : ended.includes('/') ? `ended between ${ended.replace('/', ' and ')}` : `ended in ${ended}`;
const demosText = (n: number, trained: boolean) => (trained ? `${n} demonstration${n === 1 ? '' : 's'}` : 'never trained on');
const noted = r.noted_moves;
---
<div class="moves-wrap">
  <p class="moves-sum">
    {noted
      ? `${noted.length} moves as noted at the robot, ${noted.filter((x) => x.trained).length} of them trained`
      : `${r.rollouts} rollouts, ${r.moves.length} move${r.moves.length === 1 ? '' : 's'}, scored from the arm`}
  </p>
  <ol class="moves" tabindex="0" aria-label="Moves, in the order they were run; scroll right for more">
    {noted ? noted.map((mv, i) => (
      <>
        {(i === 0 || dayOf(mv.take) !== dayOf(noted[i - 1].take)) && <li class="day" aria-label={`On the robot, ${dayOf(mv.take)}`}><span>{dayOf(mv.take)}</span></li>}
        <li class:list={['mv', !mv.trained && 'untrained']} style={`--c: var(--st-${stageIdx(mv.stage) + 1})`}>
          <p class="top"><span class="no num">{mv.n}</span><b class="move">{moveLabel(mv.move)}</b></p>
          <p class="out">{OUTCOME[mv.outcome] ?? mv.outcome}</p>
          <p class="meta">{[endedText(mv.ended, mv.move), demosText(mv.demos, mv.trained), mv.attempts > 1 && `${mv.attempts} rollouts, the last one counted`].filter(Boolean).join(' · ')}</p>
          <p class="said">{`“${mv.note}”`}</p>
        </li>
      </>
    )) : r.moves.map((mv) => {
      const best = [...stages].reverse().find((s) => mv.stages[s.key as keyof typeof mv.stages] > 0);
      return (
        <li class:list={['mv', !mv.demos && 'untrained']} style={`--c: var(--st-${stageIdx(best?.key ?? stages[0].key) + 1})`}>
          <p class="top"><b class="move">{moveLabel(mv.move)}</b></p>
          <p class="out">{`${mv.rollouts} rollout${mv.rollouts === 1 ? '' : 's'}`}</p>
          <ul class="counts">
            {stages.map((s, i) => mv.stages[s.key as keyof typeof mv.stages] > 0 && (
              <li><i style={`background: var(--st-${i + 1})`}></i>{`${mv.stages[s.key as keyof typeof mv.stages]} ${s.label.toLowerCase()}`}</li>
            ))}
          </ul>
          <p class="meta">{demosText(mv.demos, mv.demos > 0)}</p>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .moves-wrap { min-width: 0; }
  .moves-sum { font-size: 0.8rem; color: var(--ink-2); margin: 0 0 0.35rem; max-width: none; }
  /* the moves of a run on one line, each a card as wide as the next, scrolling to the right */
  .moves { list-style: none; margin: 0; padding: 0 0 0.5rem; display: flex; align-items: stretch; gap: 0.4rem; overflow-x: auto; scroll-snap-type: x proximity; }
  .mv { flex: none; width: 11.5rem; box-sizing: border-box; display: grid; align-content: start; gap: 0.15rem; padding: 0.4rem 0.55rem 0.5rem;
        border: 1px solid var(--rule); border-top: 3px solid var(--c, var(--steel)); border-radius: 0 0 6px 6px; background: var(--raise); scroll-snap-align: start; }
  .mv p { margin: 0; max-width: none; }
  .top { display: flex; align-items: baseline; gap: 0.4rem; }
  .no { font-size: 0.72rem; color: var(--steel); min-width: 1.1rem; }
  .top .move { font-size: 0.95rem; }
  .out { font-size: 0.82rem; font-weight: 620; line-height: 1.25; }
  .meta { font-size: 0.72rem; color: var(--ink-2); line-height: 1.3; }
  .untrained .meta { color: var(--ink); }
  .untrained { border-style: dashed; border-top-style: solid; }
  .said { font-size: 0.75rem; color: var(--ink-2); line-height: 1.3; margin-top: 0.15rem; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .mv:hover .said, .mv:focus-within .said { -webkit-line-clamp: unset; }
  .counts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.05rem; font-size: 0.75rem; }
  .counts li { display: flex; align-items: center; gap: 0.35rem; }
  .counts i { width: 0.55rem; height: 0.55rem; border-radius: 2px; flex: none; }
  /* a new day on the robot: a slim marker between the cards */
  .day { flex: none; display: grid; place-items: center; padding: 0 0.15rem; border-left: 2px solid var(--ink); }
  .day span { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.72rem; font-weight: 650; white-space: nowrap; }
</style>
